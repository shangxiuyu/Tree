if sys.version_info < (3, 9):
    print(f"❌ Tree CLI 需要 Python 3.9+（当前为 {sys.version.split()[0]}）", file=sys.stderr)
    sys.exit(1)

_SCRIPT_DIR = str(Path(__file__).resolve().parent)
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)
import tree_focus  # noqa: E402
import tree_seed  # noqa: E402

DEFAULT_BRANCHES = [
    "01-关于我",
    "02-我的思考",
    "03-我正在做的事",
    "04-我如何工作",
]
DEFAULT_IDENTITY_BRANCHES = ["01-关于我"]
DEFAULT_L0_EXCLUDED_BRANCHES: list[str] = []
DEFAULT_L0_STALE_DAYS = 90
DEFAULT_L0_RECENT_DAYS = 14
DEFAULT_L0_MAX_CHARS = 18000
HEAT_AUDIT_WINDOW_DAYS = 30
HEAT_HALF_LIFE_DAYS = 14.0
DORMANT_STATUSES = {"paused", "archived", "superseded"}

README_READ_TTL_SECONDS = 7200  # 2 hours


RESERVED_TOP_DIRS = {
    ".tree",
    ".git",
    "outputs",
    "seed",
    "bin",
    "skills",
    "tests",
    "vault",
    "__pycache__",
    "node_modules",
}


def load_tree_config(root: Path) -> dict:
    config_file = root / ".tree" / "config.json"
    if config_file.is_file():
        try:
            data = json.loads(config_file.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                return data
        except Exception:
            pass
    return {}


def _sync_branch_into_config(root: Path, branch_name: str) -> bool:
    """Auto-register a newly created top-level content branch into `.tree/config.json`."""
    b = branch_name.strip()
    if not b or b.startswith(".") or b in RESERVED_TOP_DIRS:
        return False
    config_file = root / ".tree" / "config.json"
    if not config_file.is_file():
        return False
    cfg = load_tree_config(root)
    branches = cfg.get("branches")
    if not isinstance(branches, list):
        branches = list(DEFAULT_BRANCHES)
    clean_branches = [str(x).strip() for x in branches if isinstance(x, str) and str(x).strip()]
    if b in clean_branches:
        return False
    clean_branches.append(b)
    cfg["branches"] = clean_branches
    atomic_write_text(config_file, json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    return True


def get_branches(root: Path) -> list[str]:
    cfg = load_tree_config(root)
    raw = cfg.get("branches")
    configured = (
        [b.strip() for b in raw if isinstance(b, str) and b.strip()]
        if isinstance(raw, list) and all(isinstance(b, str) and b.strip() for b in raw)
        else list(DEFAULT_BRANCHES)
    )
    discovered: list[str] = []
    if root.is_dir():
        try:
            for d in sorted(root.iterdir(), key=lambda p: p.name):
                if d.is_dir() and not d.name.startswith(".") and d.name not in RESERVED_TOP_DIRS:
                    discovered.append(d.name)
        except Exception:
            pass
    merged: list[str] = []
    seen: set[str] = set()
    for b in configured:
        if b not in seen:
            merged.append(b)
            seen.add(b)
    for d in discovered:
        if d not in seen:
            merged.append(d)
            seen.add(d)
    return merged


def get_branch_roles(root: Path, branches: list[str] | None = None) -> dict[str, set[str]]:
    """Resolve semantic branch roles (`identity`, `thinking`, `active`, `norms`) from config or default prefixes."""
    all_branches = branches if branches is not None else get_branches(root)
    cfg = load_tree_config(root)
    raw_roles = cfg.get("branch_roles")
    roles: dict[str, set[str]] = {"identity": set(), "thinking": set(), "active": set(), "norms": set()}
    if isinstance(raw_roles, dict):
        for role_key in roles:
            vals = raw_roles.get(role_key)
            if isinstance(vals, list):
                for v in vals:
                    if isinstance(v, str) and v.strip():
                        roles[role_key].add(v.strip())
    # Backward-compatible inference when a role isn't explicitly configured
    if not roles["identity"]:
        roles["identity"] = set(get_identity_branches(root, all_branches))
    if not roles["thinking"]:
        roles["thinking"] = {b for b in all_branches if b.startswith("02-")}
    if not roles["active"]:
        roles["active"] = {b for b in all_branches if b.startswith("03-")}
    if not roles["norms"]:
        roles["norms"] = {b for b in all_branches if b.startswith("04-")}
    return roles


def get_identity_branches(root: Path, branches: list[str]) -> list[str]:
    cfg = load_tree_config(root)
    id_branches = cfg.get("identity_branches")
    if isinstance(id_branches, list) and id_branches:
        return [b.strip() for b in id_branches if isinstance(b, str) and b.strip()]
    for candidate in ("01-关于我", "01-我是谁"):
        if candidate in branches:
            return [candidate]
    return branches[:1]


GENERIC_WHEN_TOKENS = {
    "ai", "产品", "工作", "work", "思考", "文档", "笔记", "开发", "代码", "工具",
    "python", "node", "js", "ts", "markdown", "md", "general", "daily",
}


def is_always_loaded(meta: dict[str, str], branch: str = "", identity_set: set[str] | None = None) -> bool:
    """Return whether a page is pinned for full L0 injection at cold start (explicit `always: true` only)."""
    raw = meta.get("always", "").strip().lower()
    return raw in {"true", "yes", "1"}


def _detect_generic_when_tokens(when_val: str) -> list[str]:
    if not when_val:
        return []
    s = when_val.strip()
    if s.startswith("[") and s.endswith("]"):
        s = s[1:-1]
    hits: list[str] = []
    for tok in re.split(r"[,，;；|\n]+", s):
        t = tok.strip().strip("'\"")
        if not t or "/" in t or "\\" in t or t.startswith("~"):
            continue
        if t.lower() in GENERIC_WHEN_TOKENS and t not in hits:
            hits.append(t)
    return hits


def get_l0_excluded(root: Path) -> set[str]:
    cfg = load_tree_config(root)
    excluded = cfg.get("l0_excluded_branches")
    if isinstance(excluded, list):
        return {b.strip() for b in excluded if isinstance(b, str) and b.strip()}
    return set(DEFAULT_L0_EXCLUDED_BRANCHES)


def get_l0_stale_days(root: Path) -> int:
    cfg = load_tree_config(root)
    val = cfg.get("l0_stale_days")
    if isinstance(val, int) and val > 0:
        return val
    return DEFAULT_L0_STALE_DAYS


def get_l0_recent_days(root: Path) -> int:
    cfg = load_tree_config(root)
    val = cfg.get("l0_recent_days")
    if isinstance(val, int) and val > 0:
        return val
    return DEFAULT_L0_RECENT_DAYS


def load_recent_audit_usage(
    root: Path,
    window_days: int = HEAT_AUDIT_WINDOW_DAYS,
    today: datetime.date | None = None,
) -> dict[str, tuple[set[datetime.date], set[datetime.date]]]:
    """Aggregate deduplicated recent write/read active days per page from .tree/audit.jsonl."""
    audit_path = root / ".tree" / "audit.jsonl"
    if not audit_path.is_file():
        return {}
    ref_today = today or datetime.datetime.now().date()
    usage: dict[str, tuple[set[datetime.date], set[datetime.date]]] = {}
    try:
        lines = audit_path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except Exception:
        return {}

    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except Exception:
            continue
        action = str(rec.get("action") or "")
        if action not in {"read", "write:create", "write:update"}:
            continue
        target = str(rec.get("target") or "").strip().strip("/")
        if not target or target.lower() == "readme.md" or not target.endswith(".md"):
            continue
        ts_raw = str(rec.get("timestamp") or "")
        if len(ts_raw) < 10:
            continue
        try:
            ev_date = datetime.date.fromisoformat(ts_raw[:10])
        except ValueError:
            continue
        delta = (ref_today - ev_date).days
        if delta < 0 or delta > window_days:
            continue
        writes, reads = usage.setdefault(target, (set(), set()))
        if action.startswith("write:"):
            writes.add(ev_date)
        else:
            reads.add(ev_date)
    return usage


def compute_page_heat(
    rel_path: str,
    age_days: int,
    kind: str,
    usage_map: dict[str, tuple[set[datetime.date], set[datetime.date]]],
    today: datetime.date | None = None,
    origin: str = "self",
) -> tuple[float, int]:
    """
    Compute deterministic, naturally-decaying activity heat score (zero manual tags).
    Combines:
      1) Recency of `updated` (14-day half-life)
      2) Recent deduplicated write/read active days from .tree/audit.jsonl (graceful fallback when empty)
      3) Lightweight decaying prior for active `kind: project` pages (<= 30 days)
      4) Priority discount (0.55x) for `origin: external` reference pages so they don't crowd out core personal pages
    Returns (heat_score, recent_active_days_count).
    """
    ref_today = today or datetime.datetime.now().date()
    safe_age = max(0, age_days)
    recency_score = 40.0 * (0.5 ** (safe_age / HEAT_HALF_LIFE_DAYS))

    writes, reads = usage_map.get(rel_path, (set(), set()))
    write_score = sum(
        14.0 * (0.5 ** (max(0, (ref_today - d).days) / HEAT_HALF_LIFE_DAYS))
        for d in writes
    )
    read_score = sum(
        9.0 * (0.5 ** (max(0, (ref_today - d).days) / HEAT_HALF_LIFE_DAYS))
        for d in reads
    )
    prior_score = (
        10.0 * (0.5 ** (safe_age / HEAT_HALF_LIFE_DAYS))
        if kind == "project" and safe_age <= HEAT_AUDIT_WINDOW_DAYS
        else 0.0
    )

    total = recency_score + min(write_score, 35.0) + min(read_score, 27.0) + prior_score
    if origin == "external":
        total *= 0.55
    total = round(total, 2)
    active_days = len(writes | reads)
    return total, active_days


def _strip_unquoted_comment(val: str) -> str:
    """Strip inline YAML comment (` #...`) outside single/double quotes."""
    in_quote: str | None = None
    escaped = False
    for idx, ch in enumerate(val):
        if escaped:
            escaped = False
            continue
        if ch == "\\" and in_quote == '"':
            escaped = True
            continue
        if in_quote:
            if ch == in_quote:
                in_quote = None
            continue
        if ch in ('"', "'"):
            in_quote = ch
            continue
        if ch == "#" and idx > 0 and val[idx - 1].isspace():
            return val[:idx].rstrip()
    return val.rstrip()


def _unquote_yaml_scalar(val: str) -> str:
    """Extract a single/double-quoted YAML scalar (handling escaped quotes) or strip unquoted comments."""
    val = val.strip()
    if not val:
        return ""
    if val[0] == '"':
        out: list[str] = []
        escaped = False
        for ch in val[1:]:
            if escaped:
                out.append(ch)
                escaped = False
                continue
            if ch == "\\":
                escaped = True
                continue
            if ch == '"':
                return "".join(out)
            out.append(ch)
        return "".join(out)
    if val[0] == "'":
        i = 1
        out = []
        while i < len(val):
            if val[i] == "'":
                if i + 1 < len(val) and val[i + 1] == "'":
                    out.append("'")
                    i += 2
                    continue
                return "".join(out)
            out.append(val[i])
            i += 1
        return "".join(out)
    return _strip_unquoted_comment(val)


def _split_yaml_inline_array(inner: str) -> list[str]:
    """Split items inside `[...]` without splitting on commas inside quotes."""
    items: list[str] = []
    buf: list[str] = []
    in_quote: str | None = None
    escaped = False
    for ch in inner:
        if escaped:
            buf.append(ch)
            escaped = False
            continue
        if ch == "\\" and in_quote == '"':
            buf.append(ch)
            escaped = True
            continue
        if in_quote:
            buf.append(ch)
            if ch == in_quote:
                in_quote = None
            continue
        if ch in ('"', "'"):
            in_quote = ch
            buf.append(ch)
            continue
        if ch == ",":
            tok = "".join(buf).strip()
            if tok:
                items.append(tok)
            buf = []
            continue
        buf.append(ch)
    tail = "".join(buf).strip()
    if tail:
        items.append(tail)
    return items


def _extract_frontmatter_span(text: str) -> tuple[str, int, int] | None:
    """Return `(normalized, fm_end_index, body_start_index)` if text starts with valid YAML frontmatter."""
    normalized = text.replace("\r\n", "\n")
    if not normalized.startswith("---\n"):
        return None
    close_match = re.search(r"\n---[ \t]*(?:\n|$)", normalized[3:])
    if not close_match:
        return None
    return normalized, 3 + close_match.start(), 3 + close_match.end()


def parse_frontmatter(text: str) -> tuple[dict[str, str], str]:
    """Parse minimal YAML frontmatter (scalars + inline/block lists) without external dependencies."""
    span = _extract_frontmatter_span(text)
    if not span:
        return {}, text
    normalized, fm_end, body_start = span
    fm_block = normalized[4:fm_end]
    body = normalized[body_start:]
    meta: dict[str, str] = {}
    lines = fm_block.splitlines()
    i = 0
    while i < len(lines):
        raw_line = lines[i]
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            i += 1
            continue
        if raw_line[0].isspace() or ":" not in raw_line:
            i += 1
            continue
        k, v = raw_line.split(":", 1)
        key = k.strip().lower()
        val = v.strip()
        if not val:
            items: list[str] = []
            j = i + 1
            while j < len(lines):
                nxt = lines[j]
                nxt_s = nxt.strip()
                if not nxt_s or nxt_s.startswith("#"):
                    j += 1
                    continue
                if re.match(r"^\s*-\s+", nxt):
                    raw_item = re.sub(r"^\s*-\s+", "", nxt).strip()
                    items.append(_unquote_yaml_scalar(raw_item))
                    j += 1
                else:
                    break
            if items:
                meta[key] = "[" + ", ".join(items) + "]"
                i = j
                continue
        val = _unquote_yaml_scalar(val)
        if key:
            meta[key] = val
        i += 1
    return meta, body


def _split_frontmatter_entries(fm_block: str) -> list[tuple[str, list[str]]]:
    """Split a YAML frontmatter block into `(lower_key, raw_lines)` entries preserving block lists and order."""
    entries: list[tuple[str, list[str]]] = []
    lines = fm_block.splitlines()
    i = 0
    while i < len(lines):
        raw = lines[i]
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            i += 1
            continue
        if not raw[0].isspace() and ":" in raw:
            key = raw.split(":", 1)[0].strip().lower()
            block = [raw]
            j = i + 1
            while j < len(lines) and (not lines[j].strip() or lines[j][0].isspace()):
                if lines[j].strip():
                    block.append(lines[j])
                j += 1
            entries.append((key, block))
            i = j
            continue
        i += 1
    return entries


def _rel_posix(path: Path, root: Path) -> str:
    """Return a POSIX-style relative path (always forward slashes, cross-platform safe)."""
    return path.relative_to(root).as_posix()


def _format_yaml_scalar(val: str) -> str:
    """Sanitize a CLI metadata value against newline injection and quote YAML-unsafe scalars."""
    clean = re.sub(r"[\r\n]+", " ", str(val)).strip()
    if not clean:
        return ""
    if (clean.startswith('"') and clean.endswith('"')) or (clean.startswith("'") and clean.endswith("'")):
        return clean
    needs_quote = (
        ": " in clean
        or clean.endswith(":")
        or " #" in clean
        or clean[0] in ("#", "@", "`", "{", "}", "[", "]", "!", "&", "*", "?", "|", ">", "%")
    )
    if needs_quote:
        escaped = clean.replace("\\", "\\\\").replace('"', '\\"')
        return f'"{escaped}"'
    return clean


def _replace_outside_code(text: str, replacer) -> str:
    """Apply `replacer(chunk)` only to Markdown prose outside fenced code blocks and inline code spans."""
    code_re = re.compile(r"(```[\s\S]*?```|`[^`\n]+`)")
    out: list[str] = []
    pos = 0
    for m in code_re.finditer(text):
        if m.start() > pos:
            out.append(replacer(text[pos : m.start()]))
        out.append(m.group(0))
        pos = m.end()
    if pos < len(text):
        out.append(replacer(text[pos:]))
    return "".join(out)


def _merge_frontmatter_blocks(old_raw: str, incoming_content: str) -> str:
    """Key-level merge of existing YAML frontmatter into incoming content so partial updates never wipe old metadata."""
    old_span = _extract_frontmatter_span(old_raw)
    if not old_span:
        return incoming_content
    norm_old, old_end, _ = old_span
    old_fm_block = norm_old[4:old_end]
    in_span = _extract_frontmatter_span(incoming_content)
    if not in_span:
        _, in_body = parse_frontmatter(incoming_content)
        fm_header = norm_old[: old_end + 4]
        return f"{fm_header}\n\n{in_body.strip()}\n"

    norm_in, in_end, in_body_start = in_span
    in_fm_block = norm_in[4:in_end]
    in_body = norm_in[in_body_start:].lstrip("\n")

    old_entries = _split_frontmatter_entries(old_fm_block)
    in_entries = _split_frontmatter_entries(in_fm_block)
    in_map: dict[str, list[str]] = {k: blk for k, blk in in_entries}
    merged_lines: list[str] = []
    emitted: set[str] = set()

    for k, blk in old_entries:
        if k == "focus" or k in emitted:
            continue
        if k in in_map:
            merged_lines.extend(in_map[k])
        else:
            merged_lines.extend(blk)
        emitted.add(k)
    for k, blk in in_entries:
        if k not in emitted and k != "focus":
            merged_lines.extend(blk)
            emitted.add(k)

    header = "---\n" + "\n".join(merged_lines) + "\n---"
    return f"{header}\n\n{in_body}" if in_body.strip() else header + "\n"


def upsert_frontmatter(
    content: str,
    updated_date: str,
    status: str = "",
    kind: str = "",
    location: str = "",
    when: str = "",
    always: bool | None = None,
    origin: str = "",
    source: str = "",
) -> str:
    """Inject or refresh updated date (and optional always / status / kind / location / when / origin / source) in Markdown frontmatter."""
    status_f = _format_yaml_scalar(status) if status else ""
    kind_f = _format_yaml_scalar(kind) if kind else ""
    location_f = _format_yaml_scalar(location) if location else ""
    when_f = _format_yaml_scalar(when) if when else ""
    origin_f = _format_yaml_scalar(origin) if origin else ""
    source_f = _format_yaml_scalar(source) if source else ""

    normalized = content.replace("\r\n", "\n").rstrip()
    span = _extract_frontmatter_span(normalized)
    if span:
        norm_text, fm_end, body_start = span
        fm_lines = norm_text[4:fm_end].splitlines()
        body = norm_text[body_start:].lstrip("\n")
        new_lines: list[str] = []
        saw_updated = False
        saw_always = False
        saw_status = False
        saw_kind = False
        saw_location = False
        saw_when = False
        saw_origin = False
        saw_source = False
        idx = 0
        while idx < len(fm_lines):
            line = fm_lines[idx]
            stripped = line.strip()
            low = stripped.lower()
            is_top_key = bool(stripped) and not line[0].isspace() and ":" in line

            def _skip_block_children(start_idx: int) -> int:
                nxt = start_idx + 1
                while nxt < len(fm_lines) and (not fm_lines[nxt].strip() or fm_lines[nxt][0].isspace()):
                    nxt += 1
                return nxt

            if is_top_key and low.startswith("updated:"):
                if not saw_updated:
                    new_lines.append(f"updated: {updated_date}")
                    saw_updated = True
                idx = _skip_block_children(idx)
            elif is_top_key and always is not None and low.startswith("always:"):
                if not saw_always:
                    new_lines.append(f"always: {'true' if always else 'false'}")
                    saw_always = True
                idx = _skip_block_children(idx)
            elif is_top_key and status_f and low.startswith("status:"):
                if not saw_status:
                    new_lines.append(f"status: {status_f}")
                    saw_status = True
                idx = _skip_block_children(idx)
            elif is_top_key and low.startswith("focus:"):
                # Silently strip legacy static `focus:` field on write
                idx = _skip_block_children(idx)
            elif is_top_key and kind_f and low.startswith("kind:"):
                if not saw_kind:
                    new_lines.append(f"kind: {kind_f}")
                    saw_kind = True
                idx = _skip_block_children(idx)
            elif is_top_key and location_f and low.startswith("location:"):
                if not saw_location:
                    new_lines.append(f"location: {location_f}")
                    saw_location = True
                idx = _skip_block_children(idx)
            elif is_top_key and when_f and low.startswith("when:"):
                if not saw_when:
                    new_lines.append(f"when: {when_f}")
                    saw_when = True
                idx = _skip_block_children(idx)
            elif is_top_key and origin_f and low.startswith("origin:"):
                if not saw_origin:
                    new_lines.append(f"origin: {origin_f}")
                    saw_origin = True
                idx = _skip_block_children(idx)
            elif is_top_key and source_f and low.startswith("source:"):
                if not saw_source:
                    new_lines.append(f"source: {source_f}")
                    saw_source = True
                idx = _skip_block_children(idx)
            else:
                new_lines.append(line)
                idx += 1
        if not saw_updated:
            new_lines.insert(0, f"updated: {updated_date}")
        if always is not None and not saw_always:
            new_lines.append(f"always: {'true' if always else 'false'}")
        if status_f and not saw_status:
            new_lines.append(f"status: {status_f}")
        if kind_f and not saw_kind:
            new_lines.append(f"kind: {kind_f}")
        if location_f and not saw_location:
            new_lines.append(f"location: {location_f}")
        if when_f and not saw_when:
            new_lines.append(f"when: {when_f}")
        if origin_f and not saw_origin:
            new_lines.append(f"origin: {origin_f}")
        if source_f and not saw_source:
            new_lines.append(f"source: {source_f}")
        fm_text = "\n".join(new_lines)
        return f"---\n{fm_text}\n---\n\n{body}\n" if body else f"---\n{fm_text}\n---\n"
    header = [f"updated: {updated_date}"]
    if always is not None:
        header.append(f"always: {'true' if always else 'false'}")
    if status_f:
        header.append(f"status: {status_f}")
    if kind_f:
        header.append(f"kind: {kind_f}")
    if location_f:
        header.append(f"location: {location_f}")
    if when_f:
        header.append(f"when: {when_f}")
    if origin_f:
        header.append(f"origin: {origin_f}")
    if source_f:
        header.append(f"source: {source_f}")
    fm_text = "\n".join(header)
    return f"---\n{fm_text}\n---\n\n{normalized}\n"


def get_page_meta_info(md_path: Path, text: str | None = None) -> tuple[dict[str, str], str, datetime.date, str, int]:
    """Return (meta, body, effective_date, status, age_days) for a Markdown file."""
    if text is None:
        text = md_path.read_text(encoding="utf-8")
    meta, body = parse_frontmatter(text)
    today = datetime.datetime.now().date()
    effective_date: datetime.date | None = None
    raw_updated = meta.get("updated", "").strip()
    if raw_updated:
        try:
            effective_date = datetime.date.fromisoformat(raw_updated[:10])
        except ValueError:
            effective_date = None
    if effective_date is None:
        try:
            effective_date = datetime.datetime.fromtimestamp(md_path.stat().st_mtime).date()
        except Exception:
            effective_date = today
    status = (meta.get("status") or "active").strip().lower() or "active"
    age_days = max(0, (today - effective_date).days)
    return meta, body, effective_date, status, age_days


def find_readme_path(root: Path) -> Path | None:
    for name in ("README.md", "readme.md"):
        p = root / name
        if p.is_file():
            return p
    return None


def get_readme_hash(readme_path: Path) -> str:
    return hashlib.sha256(readme_path.read_bytes()).hexdigest()[:12]


def _resolve_caller_agent(agent: str = "") -> str:
    if agent:
        return agent
    for key in ("TREE_AGENT", "AHUB_AGENT_ID"):
        val = (os.environ.get(key) or "").strip()
        if val:
            return val
    # Auto-detect common host AI agent environments so multi-AI audit trails aren't anonymous
    env_rules = (
        (("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SSE_PORT"), "claude-code"),
        (("CODEX_CI", "CODEX_SANDBOX", "CODEX_THREAD_ID", "CODEX_SHELL"), "codex"),
        (("ANTIGRAVITY_AGENT", "ANTIGRAVITY_CONVERSATION_ID", "ANTIGRAVITY_CLI_ALIAS"), "antigravity"),
        (("GEMINI_CLI", "GEMINI_API_KEY_SOURCE"), "gemini-cli"),
        (("CURSOR_TRACE_ID", "CURSOR_AGENT", "CURSOR_SESSION_ID"), "cursor"),
        (("TRAE_AGENT", "TRAE_IDE"), "trae"),
        (("WINDSURF_AGENT", "CODEIUM_EDITOR"), "windsurf"),
        (("OPENCODE", "OPENCODE_SESSION"), "opencode"),
        (("HERMES_AGENT", "HERMES_SESSION"), "hermes"),
        (("WORKBUDDY_SESSION", "WORKBUDDY_AGENT"), "workbuddy"),
        (("OPENCLAW_SESSION", "OPENCLAW_AGENT"), "openclaw"),
    )
    for keys, slug in env_rules:
        if any(os.environ.get(k) for k in keys):
            return slug
    term_prog = (os.environ.get("TERM_PROGRAM") or "").strip().lower()
    for token in ("cursor", "windsurf", "trae"):
        if token in term_prog:
            return token
    return "cli-user"


def verify_readme_gate(root: Path, agent: str = "") -> None:
    """Enforce reading current README.md (via `tree rules` or `tree read README.md`) before any write/delete maintenance operation."""
    readme_path = find_readme_path(root)
    if not readme_path:
        return
    current_hash = get_readme_hash(readme_path)
    expected_detail = f"sha256:{current_hash}"
    caller_agent = _resolve_caller_agent(agent)
    audit_file = root / ".tree" / "audit.jsonl"
    now = datetime.datetime.now(datetime.timezone.utc)
    saw_stale_hash = False
    other_valid_agents: list[str] = []

    if audit_file.exists():
        lines = audit_file.read_text(encoding="utf-8", errors="ignore").splitlines()
        for line in reversed(lines):
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except Exception:
                continue
            if rec.get("action") != "read" or str(rec.get("target", "")).lower() != "readme.md":
                continue
            try:
                ts = datetime.datetime.fromisoformat(rec["timestamp"])
                if ts.tzinfo is None:
                    ts = ts.replace(tzinfo=datetime.timezone.utc)
                age = (now - ts.astimezone(datetime.timezone.utc)).total_seconds()
            except Exception:
                continue
            if age < 0:
                continue
            if age > README_READ_TTL_SECONDS:
                break
            rec_agent = str(rec.get("agent") or "cli-user")
            if rec_agent != caller_agent:
                if rec.get("detail") == expected_detail and rec_agent not in other_valid_agents:
                    other_valid_agents.append(rec_agent)
                continue
            if rec.get("detail") == expected_detail:
                return
            saw_stale_hash = True

    agent_flag = f" --agent {caller_agent}" if caller_agent and caller_agent != "cli-user" else ""
    if saw_stale_hash:
        print(
            f"❌ 维护门禁拦截：根目录 {readme_path.name} 维护准则已更新（当前版本 {expected_detail} 尚未阅读）。",
            file=sys.stderr,
        )
    else:
        print(
            f"❌ 维护门禁拦截：执行写入或维护操作前（agent={caller_agent}），必须先阅读维护准则。",
            file=sys.stderr,
        )
    if other_valid_agents:
        print(
            f"💡 检测到其他身份（{', '.join(other_valid_agents[:3])}）2 小时内已阅读当前规则；若为同一会话，请保持 `--agent` / `TREE_AGENT` 一致。",
            file=sys.stderr,
        )
    print(f"👉 请先执行: tree rules{agent_flag}", file=sys.stderr)
    sys.exit(1)


def _tree_home_pointer_file() -> Path:
    cfg_home = os.environ.get("TREE_CONFIG_HOME")
    if cfg_home:
        return Path(cfg_home).expanduser().resolve() / "home"
    return Path.home().resolve() / ".config" / "tree" / "home"


def _is_temp_path(p: Path) -> bool:
    import tempfile

    resolved = str(p.resolve())
    tmp_roots = {str(Path(tempfile.gettempdir()).resolve()), "/tmp", "/private/tmp", "/var/folders", "/private/var/folders"}
    return any(resolved == r or resolved.startswith(r + os.sep) for r in tmp_roots)


def _save_tree_home_pointer(root: Path) -> bool:
    """Persist custom TREE_HOME path into `~/.config/tree/home` so bare `tree` commands resolve automatically."""
    skill_dir = Path(__file__).resolve().parent.parent
    default_vault = (skill_dir.parent.parent / "vault").resolve()
    resolved = root.resolve()
    # Respect test isolation: only skip temp paths when TREE_CONFIG_HOME is not explicitly set
    if not os.environ.get("TREE_CONFIG_HOME") and _is_temp_path(resolved):
        return False
    pointer = _tree_home_pointer_file()
    if resolved == default_vault:
        if pointer.is_file():
            try:
                pointer.unlink()
            except Exception:
                pass
        return False
    try:
        atomic_write_text(pointer, str(resolved) + "\n")
        return True
    except Exception:
        return False


def get_tree_root() -> Path:
    env_home = (os.environ.get("TREE_HOME") or "").strip()
    if env_home:
        return Path(env_home).expanduser().resolve()
    skill_dir = Path(__file__).resolve().parent.parent
    repo_root = skill_dir.parent.parent
    vault_dir = repo_root / "vault"
    cwd = Path.cwd().resolve()
    home = Path.home().resolve()
    for candidate in (cwd, *cwd.parents):
        if candidate == home and cwd != home:
            break
        if (candidate / ".tree" / "config.json").is_file():
            return candidate
    pointer = _tree_home_pointer_file()
    if pointer.is_file():
        try:
            saved = Path(pointer.read_text(encoding="utf-8").strip()).expanduser().resolve()
            if (saved / ".tree" / "config.json").is_file():
                return saved
        except Exception:
            pass
    if (vault_dir / ".tree" / "config.json").is_file() or vault_dir.is_dir():
        return vault_dir
    # Only fall back to repo_root when running inside an actual Tree repository/vault (never e.g. ~/.claude)
    if (repo_root / "bin" / "tree").exists() or (repo_root / ".tree" / "config.json").is_file():
        return vault_dir if (repo_root / "bin" / "tree").exists() else repo_root
    return Path.cwd().resolve()


def now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).astimezone().isoformat(timespec="seconds")


def ensure_meta_dir(root: Path) -> Path:
    meta = root / ".tree"
    meta.mkdir(parents=True, exist_ok=True)
    return meta


def atomic_write_text(path: Path, content: str) -> None:
    """Write text atomically via a PID-scoped temporary file in the same directory."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.parent / f".{path.name}.{os.getpid()}.tmp"
    try:
        tmp_path.write_text(content, encoding="utf-8")
        tmp_path.replace(path)
    except Exception:
        if tmp_path.exists():
            try:
                tmp_path.unlink()
            except Exception:
                pass
        raise


def append_jsonl(path: Path, record: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(record, ensure_ascii=False) + "\n"
    with open(path, "a", encoding="utf-8") as f:
        try:
            if fcntl is not None:
                fcntl.flock(f.fileno(), fcntl.LOCK_EX)
            f.write(payload)
            f.flush()
        finally:
            if fcntl is not None:
                try:
                    fcntl.flock(f.fileno(), fcntl.LOCK_UN)
                except Exception:
                    pass


def log_audit(root: Path, action: str, target: str, agent: str = "", detail: str = "") -> None:
    meta = ensure_meta_dir(root)
    detected_agent = _resolve_caller_agent(agent)
    append_jsonl(
        meta / "audit.jsonl",
        {
            "timestamp": now_iso(),
            "action": action,
            "target": target,
            "agent": detected_agent,
            "detail": detail,
        },
    )


def git_run(root: Path, args: list[str]) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["git", "-c", "core.quotepath=false"] + args,
            cwd=str(root),
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(
            args=["git", *args],
            returncode=127,
            stdout="",
            stderr="未检测到 git 命令，请先安装 Git（macOS: xcode-select --install 或 brew install git）",
        )


def _format_git_err(res: subprocess.CompletedProcess) -> str:
    err = (res.stderr or res.stdout or "").strip()
    if "Please tell me who you are" in err or "Author identity unknown" in err:
        return "未配置 Git 身份，请运行 `git config --global user.name \"Your Name\" && git config --global user.email \"you@example.com\"`"
    return err or f"git exited with code {res.returncode}"


def git_commit_change(root: Path, rel_paths: str | list[str], action: str, reason: str, agent: str) -> tuple[bool, str]:
    if not (root / ".git").exists():
        init_res = git_run(root, ["init", "-q"])
        if init_res.returncode != 0:
            return False, _format_git_err(init_res)
    paths_list = [rel_paths] if isinstance(rel_paths, str) else list(rel_paths)
    commit_scope = list(dict.fromkeys([*paths_list, ".tree/changelog.jsonl"]))
    add_res = git_run(root, ["add", "-A", "--", *commit_scope])
    if add_res.returncode != 0:
        return False, _format_git_err(add_res)
    target_label = paths_list[0] if len(paths_list) == 1 else f"{paths_list[0]} (+{len(paths_list) - 1})"
    msg = f"tree({action}): {target_label}"
    if reason:
        msg += f" — {reason}"
    if agent:
        msg += f" [by {agent}]"
    commit_res = git_run(root, ["commit", "-q", "--only", "-m", msg, "--", *commit_scope])
    if commit_res.returncode != 0:
        return False, _format_git_err(commit_res)
    return True, ""


def _discover_vault_skill_dirs(root: Path) -> list[tuple[str, Path]]:
    """Discover user-owned standard Agent Skills (`<branch>/<skill-name>/SKILL.md`) across norms (and fallback branches)."""
    found: list[tuple[str, Path]] = []
    seen_names: set[str] = set()
    branches = get_branches(root)
    roles = get_branch_roles(root, branches)
    ordered_branches = [b for b in branches if b in roles["norms"]] + [b for b in branches if b not in roles["norms"]]
    for b in ordered_branches:
        b_dir = root / b
        if not b_dir.is_dir():
            continue
        for child in sorted(b_dir.iterdir()):
            if not child.is_dir() or child.name.startswith("."):
                continue
            skill_md = child / "SKILL.md"
            if skill_md.is_file():
                meta, _ = parse_frontmatter(skill_md.read_text(encoding="utf-8", errors="replace"))
                s_name = (meta.get("name") or child.name).strip()
                if s_name and s_name not in seen_names:
                    found.append((s_name, child))
                    seen_names.add(s_name)
    return found


def _iter_branch_pages(root: Path, b_dir: Path, include_readme: bool = False) -> list[Path]:
    """Iterate Markdown pages in a branch, treating standard Skill folders (`<dir>/SKILL.md`) as a single SKILL.md entry."""
    if not b_dir.exists():
        return []
    is_seed_branch = (b_dir.resolve() == (root / "seed").resolve())
    skill_dirs: list[Path] = []
    for child in sorted(b_dir.iterdir()):
        if child.is_dir() and not child.name.startswith(".") and (child / "SKILL.md").is_file():
            skill_dirs.append(child.resolve())

    pages: list[Path] = []
    for f in sorted(b_dir.rglob("*.md")):
        if not include_readme and f.name.lower() == "readme.md":
            continue
        if is_seed_branch:
            rel_parts = f.relative_to(b_dir).parts
            if rel_parts and rel_parts[0] == "staging":
                continue
        resolved = f.resolve()
        in_skill_aux = False
        for s_dir in skill_dirs:
            try:
                rel_to_skill = resolved.relative_to(s_dir)
                if rel_to_skill.as_posix() != "SKILL.md":
                    in_skill_aux = True
                break
            except ValueError:
                continue
        if in_skill_aux:
            continue
        pages.append(f)
    return pages


def _seed_default_vault_skills(root: Path, only_skill: str = "") -> list[str]:
    """Copy bundled default Skill templates from `assets/default-skills/` into the norms branch if missing."""
    assets_skills = Path(__file__).resolve().parent.parent / "assets" / "default-skills"
    if not assets_skills.is_dir():
        return []
    branches = get_branches(root)
    roles = get_branch_roles(root, branches)
    work_branch = next((b for b in branches if b in roles["norms"]), "04-我如何工作")
    work_dir = root / work_branch
    work_dir.mkdir(parents=True, exist_ok=True)
    created: list[str] = []
    for src_dir in sorted(assets_skills.iterdir()):
        if not src_dir.is_dir() or not (src_dir / "SKILL.md").is_file():
            continue
        if only_skill and src_dir.name != only_skill:
            continue
        dst_dir = work_dir / src_dir.name
        if not dst_dir.exists():
            shutil.copytree(src_dir, dst_dir)
            created.append(f"{work_branch}/{src_dir.name}")
    return created


def _strip_md_summary_syntax(text: str) -> str:
    """Strip Markdown syntax from summary text while keeping underscores inside identifiers like `deploy_cloud.sh`."""
    cleaned = re.sub(r"[*`\[\]]", "", text)
    return re.sub(r"(?<!\w)_+|_+(?!\w)", "", cleaned).strip()


_PROVENANCE_TAIL_RE = re.compile(
    r"^(?:整理自|编译自|来自|摘自|收录自|出处[：:])"
)


def extract_first_summary(
    md_path: Path,
    meta: dict[str, str] | None = None,
    body: str | None = None,
) -> str:
    if meta is None or body is None:
        try:
            text = md_path.read_text(encoding="utf-8", errors="replace")
        except Exception:
            return ""
        meta, body = parse_frontmatter(text)
    if meta.get("summary"):
        s = meta["summary"].strip()
        return (s[:75] + "…") if len(s) > 75 else s
    if md_path.name == "SKILL.md" and meta.get("description"):
        s = meta["description"].strip()
        return (s[:75] + "…") if len(s) > 75 else s
    lines = [line.strip() for line in body.splitlines() if line.strip()]
    for line in lines:
        if line.startswith(">"):
            q = _strip_md_summary_syntax(re.sub(r"^>\s*", "", line))
            m = re.search(r"核心(?:定位|判断|结论|事实|原则|身份|底线)[：:]\s*(.+)$", q)
            if m:
                q = m.group(1).strip()
            else:
                m_when = re.match(r"^适用时机[：:]\s*(.+)$", q)
                if m_when:
                    inner = m_when.group(1).strip()
                    parts = re.split(r"[。；;]\s*", inner, maxsplit=1)
                    head_part = parts[0].strip()
                    tail_part = parts[1].strip() if len(parts) > 1 else ""
                    if tail_part and not _PROVENANCE_TAIL_RE.match(tail_part):
                        q = tail_part
                    elif tail_part and _PROVENANCE_TAIL_RE.match(tail_part):
                        # Tail is only source provenance (e.g. "整理自即刻收藏"); keep the substantive clause before `;`.
                        q = head_part
                    else:
                        # Line is purely `适用时机：...。` with no trailing clause; fall back to first body line.
                        q = ""
            if q:
                return (q[:75] + "…") if len(q) > 75 else q
    for line in lines:
        if line.startswith("#") or line.startswith("---") or line.startswith(">"):
            continue
        clean = _strip_md_summary_syntax(re.sub(r"^[-*+]\s+", "", line))
        if clean:
            return (clean[:75] + "…") if len(clean) > 75 else clean
    for line in lines:
        if line.startswith("#"):
            return line.lstrip("#").strip()
    return ""


def safe_resolve(root: Path, rel_path: str) -> Path:
    cleaned = rel_path.strip().lstrip("/")
    root_resolved = root.resolve()
    target = (root_resolved / cleaned).resolve()
    if not target.is_relative_to(root_resolved):
        raise ValueError(f"非法路径越界: {rel_path}")
    return target


def _get_host_skill_targets(home: Path, custom_target: str = "") -> list[tuple[str, Path, Path, bool]]:
    """Return `(label, host_root, skills_dir, explicit_target)` for local AI agents."""
    host_roots: list[tuple[str, Path, Path, bool]] = [
        ("Claude Code", home / ".claude", home / ".claude" / "skills", False),
        ("Codex", home / ".codex", home / ".codex" / "skills", False),
        ("Gemini / Antigravity", home / ".gemini" / "config", home / ".gemini" / "config" / "skills", False),
        ("Hermes Agent", home / ".hermes", home / ".hermes" / "skills", False),
        ("OpenCode", home / ".config" / "opencode", home / ".config" / "opencode" / "skills", False),
        ("Windsurf", home / ".codeium" / "windsurf", home / ".codeium" / "windsurf" / "skills", False),
        ("Universal Agents", home / ".agents", home / ".agents" / "skills", False),
        ("Cursor", home / ".cursor", home / ".cursor" / "skills", False),
        ("Trae", home / ".trae", home / ".trae" / "skills", False),
        ("WorkBuddy", home / ".workbuddy", home / ".workbuddy" / "skills", False),
        ("OpenClaw", home / ".openclaw", home / ".openclaw" / "skills", False),
    ]
    # Also mount ~/.gemini/skills when ~/.gemini exists and either ~/.gemini/config is absent
    # or ~/.gemini/skills already exists (e.g., Gemini CLI + Antigravity coexisting).
    gemini_base = home / ".gemini"
    if gemini_base.exists() and (
        not (gemini_base / "config").exists() or (gemini_base / "skills").exists()
    ):
        host_roots.insert(3, ("Gemini CLI", gemini_base, gemini_base / "skills", False))
    if custom_target:
        custom_skills_dir = Path(custom_target).expanduser()
        host_roots.append(("Custom Target", custom_skills_dir, custom_skills_dir, True))
    return host_roots


def cmd_init(root: Path, _args: argparse.Namespace) -> None:
    root.mkdir(parents=True, exist_ok=True)
    branches = get_branches(root)
    for b in branches:
        (root / b).mkdir(parents=True, exist_ok=True)
    meta = ensure_meta_dir(root)
    config_file = meta / "config.json"
    if not config_file.exists():
        config_file.write_text(
            json.dumps(
                {
                    "name": "Tree Personal Context OS",
                    "version": "0.2.0",
                    "created_at": now_iso(),
                    "branches": branches,
                    "identity_branches": DEFAULT_IDENTITY_BRANCHES,
                    "l0_excluded_branches": DEFAULT_L0_EXCLUDED_BRANCHES,
                    "l0_stale_days": DEFAULT_L0_STALE_DAYS,
                    "l0_recent_days": DEFAULT_L0_RECENT_DAYS,
                },
                ensure_ascii=False,
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
    gitignore = root / ".gitignore"
    if not gitignore.exists():
        ig_lines = [
            ".DS_Store",
            ".tree/audit.jsonl",
            ".tree/sync.log",
            "outputs/",
        ]
        if (root / "bin").exists():
            ig_lines.append("bin/__pycache__/")
        ig_lines.extend([
            ".tree/staging/",
            ".tree/sources.json",
        ])
        gitignore.write_text("\n".join(ig_lines) + "\n", encoding="utf-8")
    readme = root / "README.md"
    if not readme.exists():
        template_readme = Path(__file__).resolve().parent.parent / "assets" / "TREE_README.md"
        if template_readme.is_file() and template_readme.resolve() != readme.resolve():
            readme.write_text(template_readme.read_text(encoding="utf-8"), encoding="utf-8")
        else:
            readme.write_text(
                "# Tree —— 个人上下文底座（Personal Context OS）\n\n"
                "> **显式契约**：所有 AI Agent 写入或维护 Tree 前必须先读取本文件。\n\n"
                "- 默认四维主干：`01-关于我/`、`02-我的思考/`、`03-我正在做的事/`、`04-我如何工作/`。\n"
                "- 原则：宽进严修，原地融合优先（`UPDATE > ADD`），只记模型不知道的个人差量；用 `origin`/`source` 区分本人与外部参考。\n"
                "- 标有 `#note` 的用户手写原稿未经要求不擅改。\n",
                encoding="utf-8",
            )
    seeded_skills = _seed_default_vault_skills(root)
    init_git_warn = ""
    if not (root / ".git").exists():
        git_run(root, ["init", "-q"])
        git_run(root, ["add", "."])
        c_res = git_run(root, ["commit", "-q", "-m", "tree(init): initialize personal context tree"])
        if c_res.returncode != 0:
            init_git_warn = _format_git_err(c_res)
    saved_ptr = _save_tree_home_pointer(root)
    print(f"✅ Tree 已初始化于: {root}")
    if saved_ptr:
        print(f"📍 已记录默认知识库路径至 `{_tree_home_pointer_file()}`（此后可直接运行 `tree` 命令，无需每次传 TREE_HOME）")
    if seeded_skills:
        print(f"🧩 已在知识库内预置个人工作流模板: {', '.join(seeded_skills)}（未注册到全局客户端，可直接按需自定义）")
    if init_git_warn:
        print(f"⚠️ 初始 Git 提交未完成：{init_git_warn}", file=sys.stderr)
    which_tree = shutil.which("tree")
    this_script = Path(__file__).resolve()
    install_cmd = "tree install-skill" if (which_tree and Path(which_tree).resolve() == this_script) else "./bin/tree install-skill"
    print(f"👉 下一步：运行 `{install_cmd}` 挂载到本机 AI 客户端，随后打开任意 AI 对话发送「帮我扫描本机记忆并初始化 Tree」。")


def collect_active_always_pages(root: Path) -> list[tuple[str, str, str]]:
    """Return list of `(rel_path, body, updated_iso)` for all active `always: true` pages in the vault."""
    branches = get_branches(root)
    identity_set = set(get_identity_branches(root, branches))
    l0_excluded = get_l0_excluded(root)
    always_pages: list[tuple[str, str, str]] = []
    for b in branches:
        if b in l0_excluded:
            continue
        b_dir = root / b
        if not b_dir.exists():
            continue
        for f in _iter_branch_pages(root, b_dir):
            meta, body, eff_date, status, _ = get_page_meta_info(f)
            if is_always_loaded(meta, b, identity_set) and status not in DORMANT_STATUSES:
                always_pages.append((_rel_posix(f, root), body, eff_date.isoformat()))
    return always_pages


def auto_reconcile_external_file_edits(root: Path) -> list[str]:
    """
    Universal fallback self-healing:
    When a host agent has no Shell tool or its sandboxed Shell failed (e.g. Exit Code 127)
    and the agent fell back to editing `01~04` Markdown files directly via file-edit tools,
    detect uncommitted Markdown modifications, refresh `updated` date, auto-commit to Git,
    record changelog/audit, and sync global instruction blocks.
    """
    if not (root / ".git").exists():
        return []
    status_res = git_run(root, ["status", "--porcelain", "-uall"])
    raw_lines = [ln for ln in (status_res.stdout or "").splitlines() if ln.strip()]
    if not raw_lines:
        return []

    content_branches = tuple(get_branches(root))
    branches = tuple([*content_branches, "seed"])
    reconciled_paths: list[str] = []
    stage_paths: list[str] = []
    today_str = datetime.datetime.now().date().isoformat()
    meta_dir = ensure_meta_dir(root)

    def _decode_git_path(p_raw: str) -> str:
        p_raw = p_raw.strip()
        if p_raw.startswith('"') and p_raw.endswith('"'):
            inner = p_raw[1:-1]
            # Unescape C-style git escapes (`\"`, `\\`, `\t`, octal bytes) safely without mangling UTF-8
            buf = bytearray()
            i = 0
            while i < len(inner):
                ch = inner[i]
                if ch == "\\" and i + 1 < len(inner):
                    nxt = inner[i + 1]
                    if nxt in {"\\", '"'}:
                        buf.extend(nxt.encode("utf-8"))
                        i += 2
                        continue
                    if nxt == "t":
                        buf.extend(b"\t")
                        i += 2
                        continue
                    if nxt == "n":
                        buf.extend(b"\n")
                        i += 2
                        continue
                    if nxt in "01234567" and i + 3 < len(inner) and all(c in "01234567" for c in inner[i + 1 : i + 4]):
                        buf.append(int(inner[i + 1 : i + 4], 8))
                        i += 4
                        continue
                buf.extend(ch.encode("utf-8"))
                i += 1
            return buf.decode("utf-8", errors="replace")
        return p_raw

    # Collect Skill auxiliary directories so references/assets inside `<branch>/<skill>/` aren't polluted with frontmatter
    skill_aux_dirs: list[Path] = []
    for _sname, s_dir in _discover_vault_skill_dirs(root):
        skill_aux_dirs.append(s_dir.resolve())

    def _is_skill_aux_file(p: Path) -> bool:
        try:
            rp = p.resolve()
        except Exception:
            return False
        for s_dir in skill_aux_dirs:
            try:
                rel_s = rp.relative_to(s_dir)
                if rel_s.as_posix() != "SKILL.md":
                    return True
            except ValueError:
                continue
        return False

    for line in raw_lines:
        if len(line) < 4:
            continue
        status_xy = line[:2]
        is_untracked = (status_xy == "??")
        raw_rel = line[3:].strip()
        old_rel = ""
        if " -> " in raw_rel:
            old_part, new_part = raw_rel.split(" -> ", 1)
            old_rel = _decode_git_path(old_part)
            raw_rel = _decode_git_path(new_part)
        else:
            raw_rel = _decode_git_path(raw_rel)

        if not raw_rel.endswith(".md") or not any(raw_rel.startswith(b + "/") for b in branches):
            continue
        if raw_rel.startswith("seed/staging/") or (is_untracked and not any(raw_rel.startswith(b + "/") for b in content_branches)):
            continue
        if Path(raw_rel).name.lower() == "readme.md":
            continue
        md_file = root / raw_rel
        if _is_skill_aux_file(md_file):
            continue
        if md_file.is_file():
            try:
                old_text = md_file.read_text(encoding="utf-8")
                meta_u, _ = parse_frontmatter(old_text)
                if is_untracked:
                    already_changed_updated = bool((meta_u.get("updated") or "").strip())
                else:
                    # Check if the external edit already modified the `updated:` line; if not, refresh `updated` to today
                    head_diff = git_run(root, ["diff", "HEAD", "--", raw_rel]).stdout or ""
                    already_changed_updated = bool(re.search(r"^\+updated:\s*\d{4}-\d{2}-\d{2}", head_diff, re.MULTILINE))
                if not already_changed_updated:
                    refreshed = upsert_frontmatter(old_text, today_str)
                    if refreshed != old_text:
                        atomic_write_text(md_file, refreshed)
            except Exception:
                pass
        reconciled_paths.append(raw_rel)
        if old_rel:
            stage_paths.append(old_rel)
        stage_paths.append(raw_rel)
        append_jsonl(
            meta_dir / "changelog.jsonl",
            {
                "timestamp": now_iso(),
                "action": "reconcile",
                "path": raw_rel,
                "agent": "file-tool-fallback",
                "reason": "自动收拢宿主直接文件编辑并补齐 Git 提交",
            },
        )
        log_audit(root, "write:reconcile", raw_rel, agent="file-tool-fallback", detail="auto-reconciled direct file edit")

    if reconciled_paths:
        commit_scope = list(dict.fromkeys([*stage_paths, ".tree/changelog.jsonl"]))
        git_run(root, ["add", "-A", "--", *commit_scope])
        summary_paths = ", ".join(reconciled_paths[:3]) + (f" (+{len(reconciled_paths) - 3})" if len(reconciled_paths) > 3 else "")
        c_res = git_run(root, ["commit", "-q", "--only", "-m", f"tree(reconcile): {summary_paths} — 自动收拢宿主文件编辑", "--", *commit_scope])
        if c_res.returncode == 0:
            auto_refresh_global_instructions_if_mounted(root)
        else:
            print(f"⚠️ 自动收拢提交 Git 失败: {_format_git_err(c_res)}", file=sys.stderr)

    return reconciled_paths


def auto_refresh_global_instructions_if_mounted(root: Path) -> None:
    """Silently refresh any already-mounted global instruction blocks when vault content changes."""
    try:
        always_pages = collect_active_always_pages(root)
        results = tree_focus.sync_global_instructions(
            root,
            always_pages,
            only_existing_blocks=True,
        )
        updated = [label for label, _, st in results if st in {"updated", "created"}]
        if updated:
            print(f"🔄 已自动同步 L0 常驻底线至全局指令文件: {', '.join(updated)}")
    except Exception:
        pass


def cmd_sync_global(root: Path, args: argparse.Namespace) -> None:
    """Synchronize or remove the L0-Static managed block across installed host agents' global instruction files."""
    dry_run = bool(getattr(args, "dry_run", False))
    remove = bool(getattr(args, "remove", False))
    always_pages = collect_active_always_pages(root)
    results = tree_focus.sync_global_instructions(
        root,
        always_pages,
        dry_run=dry_run,
        remove=remove,
        only_existing_blocks=False,
    )
    action_title = "移除" if remove else "同步"
    print(f"🌐 全局指令页受控块{action_title}（`<!-- TREE-CONTEXT:START -->` ... `<!-- TREE-CONTEXT:END -->`）：")
    if not results:
        print("  (未检测到需要处理的宿主全局指令文件)")
        return
    for label, fp, st in results:
        prefix = "[DRY-RUN] " if dry_run else ""
        status_cn = {
            "created": "✅ 已创建并写入受控块",
            "updated": "✅ 已刷新受控块",
            "unchanged": "ℹ️ 已是最新（无变更）",
            "removed": "🗑️ 已移除受控块（保留用户原有内容）",
        }.get(st, st)
        print(f"  {prefix}{label:<24} {status_cn} -> {fp}")
    if not dry_run:
        log_audit(root, "sync_global", "remove" if remove else "sync", detail=f"count={len(results)}")
def cmd_install_skill(root: Path, args: argparse.Namespace) -> None:
    """Mount `tree` CLI and `tree` Skill into existing local agent directories (minimal footprint)."""
    script_path = Path(__file__).resolve()
    skill_src = script_path.parent.parent
    if not (skill_src / "SKILL.md").is_file():
        print(f"❌ 未找到 Skill 源目录: {skill_src}", file=sys.stderr)
        sys.exit(1)

    dry_run = bool(getattr(args, "dry_run", False))
    force = bool(getattr(args, "force", False))
    home = Path.home().expanduser().resolve()

    # 1. Link CLI executable into bin_dir (default ~/.local/bin/tree)
    bin_dir = Path(args.bin_dir).expanduser() if getattr(args, "bin_dir", "") else (home / ".local" / "bin")
    cli_link = bin_dir / "tree"
    print(f"🌱 Tree 安装向导（最小足迹模式{' · DRY-RUN 预览' if dry_run else ''}）")
    print(f"   CLI 源码: {script_path}")
    print(f"   Skill 源: {skill_src}\n")

    if not dry_run:
        try:
            script_path.chmod(script_path.stat().st_mode | 0o111)
        except Exception:
            pass
        bin_dir.mkdir(parents=True, exist_ok=True)
        if cli_link.is_symlink() or (cli_link.exists() and force):
            if cli_link.is_dir() and not cli_link.is_symlink():
                print(f"⚠️ 跳过 CLI 软链（目标已是目录）: {cli_link}")
            else:
                cli_link.unlink()
                cli_link.symlink_to(script_path)
                print(f"✅ 已更新 CLI 软链: {cli_link} -> {script_path}")
        elif not cli_link.exists():
            cli_link.symlink_to(script_path)
            print(f"✅ 已创建 CLI 软链: {cli_link} -> {script_path}")
        else:
            print(f"ℹ️ CLI 目标已存在（保留未覆盖，加 --force 可覆盖）: {cli_link}")
    else:
        print(f"[DRY-RUN] 将创建 CLI 软链: {cli_link} -> {script_path}")

    # 2. Mount ONLY the core `tree` skill (personal workflow skills inside `04-我如何工作/` stay inside the vault)
    skill_sources: list[tuple[str, Path]] = [(skill_src.name, skill_src)]

    # Link Skills ONLY into host agent directories that already exist on this machine
    # (Explicit --target is always honored and created if needed)
    host_roots = _get_host_skill_targets(home, custom_target=getattr(args, "target", "") or "")

    mounted = 0
    skipped = 0
    skill_names = ", ".join(name for name, _ in skill_sources)
    print(f"   待挂载 Skill: {skill_names}")
    print(f"\n📦 Skill 宿主挂载（{skill_names}；仅写入本机已存在的工具目录，绝不凭空创建）：")
    for label, host_root, skills_dir, explicit_target in host_roots:
        if not explicit_target and not host_root.exists():
            skipped += 1
            continue
        effective_skills_dir = skills_dir
        if effective_skills_dir.is_symlink() and not effective_skills_dir.exists():
            fallback_cursor = host_root / "skills-cursor"
            if label == "Cursor" and fallback_cursor.is_dir():
                effective_skills_dir = fallback_cursor
            elif not dry_run:
                effective_skills_dir.unlink()
                effective_skills_dir.mkdir(parents=True, exist_ok=True)
        elif not dry_run:
            effective_skills_dir.mkdir(parents=True, exist_ok=True)

        for s_name, s_src in skill_sources:
            # Clean up legacy `tree-context` symlink when installing renamed `tree` skill
            if s_name == "tree":
                legacy_link = effective_skills_dir / "tree-context"
                if legacy_link.is_symlink() and not dry_run:
                    legacy_link.unlink()
            link_path = effective_skills_dir / s_name
            tag = f"{label} ({s_name})"
            if dry_run:
                print(f"  [DRY-RUN] {tag:<34} -> {link_path}")
                mounted += 1
                continue
            if link_path.is_symlink():
                link_path.unlink()
                link_path.symlink_to(s_src)
                print(f"  ✅ {tag:<34} (已更新) -> {link_path}")
                mounted += 1
            elif link_path.exists():
                if force:
                    if link_path.is_dir():
                        shutil.rmtree(link_path)
                    else:
                        link_path.unlink()
                    link_path.symlink_to(s_src)
                    print(f"  ✅ {tag:<34} (已覆盖) -> {link_path}")
                    mounted += 1
                else:
                    print(f"  ℹ️ {tag:<34} (已存在非软链目录，跳过；加 --force 覆盖) -> {link_path}")
            else:
                link_path.symlink_to(s_src)
                print(f"  ✅ {tag:<34} (已挂载) -> {link_path}")
                mounted += 1

    print(f"\n完成：已处理 {mounted} 项 Skill 挂载，跳过 {skipped} 个本机未安装的工具。")

    # 3. Sync L0-Static managed block into host global instruction files (unless --no-global-rules or --target)
    if getattr(args, "target", "") and not getattr(args, "no_global_rules", False):
        print("\nℹ️ 说明：已指定 `--target` 自定义 Skill 目录，默认跳过全局指令文件同步（如需同步请单独运行 `tree sync-global`）。")
    if not getattr(args, "no_global_rules", False) and not getattr(args, "target", ""):
        print("")
        always_pages = collect_active_always_pages(root)
        g_results = tree_focus.sync_global_instructions(
            root,
            always_pages,
            dry_run=dry_run,
            remove=False,
            only_existing_blocks=False,
        )
        print("🌐 全局指令文件受控块同步（第 0 秒常驻底线 + 第 1 秒情境点亮唤醒器）：")
        for label, fp, st in g_results:
            prefix = "[DRY-RUN] " if dry_run else ""
            status_cn = {
                "created": "✅ 已写入受控块",
                "updated": "✅ 已更新受控块",
                "unchanged": "✅ 已是最新",
            }.get(st, st)
            print(f"  {prefix}{label:<24} {status_cn} -> {fp}")

    # 4. Universal Environment Self-Healing (Shell RC PATH check + WorkBuddy Sandbox allowlist + Pending edit reconcile)
    rc_repairs = tree_focus.check_and_repair_shell_rc_path(home=home, dry_run=dry_run)
    wb_updated, wb_msg = tree_focus.ensure_workbuddy_sandbox_allow_write(root, home=home, dry_run=dry_run)
    if rc_repairs or wb_updated:
        print("\n🛠️ 宿主环境与沙盒自适应修复：")
        prefix = "[DRY-RUN] " if dry_run else ""
        for rc_path, r_msg in rc_repairs:
            print(f"  {prefix}✅ {rc_path}: {r_msg}")
        if wb_updated:
            print(f"  {prefix}✅ WorkBuddy 沙盒授权: {wb_msg}")
    vault_initialized = (root / ".tree" / "config.json").is_file() or (root / "README.md").is_file()
    if not dry_run and vault_initialized:
        _save_tree_home_pointer(root)
        reconciled = auto_reconcile_external_file_edits(root)
        if reconciled:
            print(f"  🔄 已自动收拢并提交 {len(reconciled)} 处宿主直接文件编辑: {', '.join(reconciled)}")
    elif not vault_initialized:
        print(f"💡 提示：知识库 `{root}` 尚未初始化；可运行 `tree init` 创建默认目录与维护契约。")

    shell_rc = "~/.bashrc" if "bash" in os.environ.get("SHELL", "") else "~/.zshrc"
    path_env = os.environ.get("PATH", "").split(os.pathsep)
    which_tree = shutil.which("tree")
    this_script = Path(__file__).resolve()
    if which_tree and Path(which_tree).resolve() != this_script:
        print(
            f"⚠️ 检测到系统同名命令冲突：当前 `tree` 指向 `{which_tree}`（而非 `{bin_dir / 'tree'}`）。\n"
            f"   请在 `{shell_rc}` 中将 `{bin_dir}` 置于 PATH 最前：`export PATH=\"{bin_dir}:$PATH\"`，随后执行 `source {shell_rc}`；或始终使用 `{bin_dir / 'tree'}`。"
        )
    elif str(bin_dir) not in path_env and str(bin_dir.resolve()) not in path_env:
        print(f"💡 提示：`{bin_dir}` 尚未加入 PATH，可在 `{shell_rc}` 添加：`export PATH=\"{bin_dir}:$PATH\"`")
    if (home / ".cursor").is_dir() or (home / ".trae").is_dir():
        print("ℹ️ 说明：Cursor / Trae 的全局用户规则由客户端内置管理，已为其挂载 Skill 入口；如需第 0 秒常驻底线，可在客户端 Rules 设置中按需粘贴。")
    if vault_initialized:
        print("\n🚀 接下来可以立刻体验：")
        print("  1. 打开任意已挂载的 AI 客户端，直接发送：「帮我扫描本机记忆并初始化 Tree」")
        print("  2. 日常可直接用 Obsidian / VS Code 浏览知识库，或运行 `tree lint` / `tree log` 检查结构与演进")
    if not dry_run and vault_initialized:
        log_audit(root, "install_skill", str(skill_src), detail=f"mounted={mounted}")


def cmd_context(root: Path, args: argparse.Namespace) -> None:
    """Output L0 Progressive Disclosure Context Package for AI Agents."""
    auto_reconcile_external_file_edits(root)
    raw_cwd = getattr(args, "cwd", "") or ""
    caller_cwd = Path(raw_cwd).expanduser().resolve() if raw_cwd else Path.cwd().resolve()
    query_str = (getattr(args, "query", "") or "").strip()
    no_auto_focus = bool(getattr(args, "no_auto_focus", False))

    log_audit(
        root,
        "context_package",
        "L0",
        detail=f"cwd={caller_cwd}" + (f",q={query_str}" if query_str else ""),
    )
    branches = get_branches(root)
    identity_branches = get_identity_branches(root, branches)
    l0_excluded = get_l0_excluded(root)
    stale_days = get_l0_stale_days(root)
    recent_days = get_l0_recent_days(root)

    out = []
    out.append("# [Tree Personal Context — L0 全景导航包]")
    out.append(
        f"> 仓库路径: `{root}` | 情境透镜: `tree context -q \"<话题>\"` | 按需精读: `tree read \"<相对路径>\"` | 写入前必读: `tree rules`"
    )
    out.append("")

    # Collect always-on (L0) pages, active on-demand pages, and PageNodes for Situational Auto-Focus
    identity_set = set(identity_branches)
    usage_map = load_recent_audit_usage(root)
    always_items: list[tuple[Path, str, datetime.date]] = []
    branch_active_map: list[tuple[str, list[tuple[float, datetime.date, Path, str, int, int, str, str, str]], int, int]] = []
    hot_items: list[tuple[float, datetime.date, Path, str, int, str, str, str]] = []
    focus_nodes: list[tree_focus.PageNode] = []

    for b in branches:
        if b in l0_excluded:
            continue
        b_dir = root / b
        if not b_dir.exists():
            continue
        files = _iter_branch_pages(root, b_dir)
        active_items: list[tuple[float, datetime.date, Path, str, int, int, str, str, str]] = []
        always_in_branch = 0
        dormant_count = 0
        for f in files:
            meta, body, eff_date, status, age_days = get_page_meta_info(f)
            always_flag = is_always_loaded(meta, b, identity_set)
            kind = (meta.get("kind") or "").strip().lower()
            origin = (meta.get("origin") or "self").strip().lower() or "self"
            source = (meta.get("source") or "").strip()
            location = (meta.get("location") or "").strip()
            summary = extract_first_summary(f, meta=meta, body=body)
            rel_str = _rel_posix(f, root)
            heat_score, active_days = compute_page_heat(rel_str, age_days, kind, usage_map, origin=origin)

            if status not in DORMANT_STATUSES and age_days <= stale_days:
                focus_nodes.append(
                    tree_focus.PageNode(
                        path=f,
                        rel_path=rel_str,
                        branch=b,
                        stem=f.stem,
                        meta=meta,
                        body=body,
                        updated_iso=eff_date.isoformat(),
                        status=status,
                        age_days=age_days,
                        is_always=always_flag,
                        heat_score=heat_score,
                        summary=summary,
                        trigger_hint=tree_focus._extract_trigger_hint(meta, body),
                        locations=tree_focus._split_multi_values(location),
                        when_rules=tree_focus._split_multi_values(meta.get("when", "")),
                        tags=tree_focus._extract_tags(meta, body),
                        wikilinks=tree_focus._extract_wikilinks(body),
                        origin=origin,
                        source=source,
                    )
                )

            if always_flag:
                if status in DORMANT_STATUSES:
                    dormant_count += 1
                    continue
                always_in_branch += 1
                always_items.append((f, body, eff_date))
                continue
            if status in DORMANT_STATUSES or age_days > stale_days:
                dormant_count += 1
                continue
            active_items.append((heat_score, eff_date, f, summary, active_days, age_days, kind, location, origin))
            if age_days <= recent_days or active_days > 0:
                hot_items.append((heat_score, eff_date, f, summary, active_days, kind, location, origin))
        active_items.sort(key=lambda x: (x[0], x[1], x[2].as_posix()), reverse=True)
        branch_active_map.append((b, active_items, dormant_count, always_in_branch))

    # Backward-compatible read support if a legacy `seed/` directory still exists on disk
    seed_dir = root / "seed"
    active_seed_items: list[tuple[Path, datetime.date, str]] = []
    dormant_seed_count = 0
    if seed_dir.is_dir():
        for sf in _iter_branch_pages(root, seed_dir):
            sf_meta, sf_body, sf_date, sf_status, sf_age = get_page_meta_info(sf)
            if sf_status in DORMANT_STATUSES:
                dormant_seed_count += 1
                continue
            sf_rel = _rel_posix(sf, root)
            sf_sum = extract_first_summary(sf, meta=sf_meta, body=sf_body)
            sf_origin = (sf_meta.get("origin") or "external").strip().lower() or "external"
            sf_source = (sf_meta.get("source") or "").strip()
            sf_heat, _ = compute_page_heat(sf_rel, sf_age, (sf_meta.get("kind") or "").strip().lower(), usage_map, origin=sf_origin)
            active_seed_items.append((sf, sf_date, sf_sum))
            focus_nodes.append(
                tree_focus.PageNode(
                    path=sf,
                    rel_path=sf_rel,
                    branch="seed",
                    stem=sf.stem,
                    meta=sf_meta,
                    body=sf_body,
                    updated_iso=sf_date.isoformat(),
                    status=sf_status,
                    age_days=sf_age,
                    is_always=False,
                    heat_score=sf_heat,
                    summary=sf_sum,
                    trigger_hint=tree_focus._extract_trigger_hint(sf_meta, sf_body),
                    locations=tree_focus._split_multi_values((sf_meta.get("location") or "").strip()),
                    when_rules=tree_focus._split_multi_values(sf_meta.get("when", "")),
                    tags=tree_focus._extract_tags(sf_meta, sf_body),
                    wikilinks=tree_focus._extract_wikilinks(sf_body),
                    origin=sf_origin,
                    source=sf_source,
                )
            )

    # 1. Always-loaded core pages (always: true, decoupled from directory ownership)
    skip_always = bool(getattr(args, "no_always", False))
    if always_items:
        out.append("## 一、常驻核心上下文（L0 Always-On）")
        if skip_always:
            out.append("> *（已启用 `--no-always`：以下常驻页面已由宿主全局指令注入，跳过重复全文；如需查看完整内容请按需 `tree read`）*")
            for f, body, eff_date in always_items:
                rel = _rel_posix(f, root)
                body_lines = [ln for ln in body.strip().splitlines() if ln.strip()]
                line_hint = f" · 共 {len(body_lines)} 行" if len(body_lines) > 45 else ""
                out.append(f"- 📄 `{rel}` [{eff_date.isoformat()}{line_hint}] — {extract_first_summary(f, body=body)}")
            out.append("")
        else:
            for f, body, eff_date in always_items:
                rel = _rel_posix(f, root)
                body_lines = [ln for ln in body.strip().splitlines() if ln.strip()]
                max_lines = 45
                snippet = "\n".join(body_lines[:max_lines])
                if len(body_lines) > max_lines:
                    snippet += f"\n…[已截断，余 {len(body_lines) - max_lines} 行，完整内容见 `tree read \"{rel}\"`]"
                out.append(f"### 📄 `{rel}` [{eff_date.isoformat()}]")
                out.append(snippet)
                out.append("")
    else:
        out.append("## 一、常驻核心上下文（L0 Always-On）")
        out.append("> 🌱 **[SEED_STATE: 幼苗未破土]** 当前 Tree 尚未初始化个人画像与核心底线。")
        out.append("> 建议宿主 Agent 引导用户 3 选 1 破土：① 运行 `tree seed scan` 迁移本机旧记忆与历史对话；② 提 3 个高杠杆问题口述生成初始幼苗；③ 先干活，边聊边种。")
        out.append("")

    # Reserve guaranteed character budget for Section 3 directory map before rendering focus & spotlight
    min_dir_budget = 4500
    pre_focus_chars = sum(len(x) + 1 for x in out)
    focus_spot_budget = max(2500, DEFAULT_L0_MAX_CHARS - pre_focus_chars - min_dir_budget)

    # 1.5 Situational Auto-Focus & Cross-Branch Resonance (01 <-> 02 <-> 03 <-> 04)
    focus_lines: list[str] = []
    if not no_auto_focus and focus_nodes:
        ws_signal = tree_focus.probe_workspace(root, caller_cwd=caller_cwd, query=query_str)
        focus_bundle = tree_focus.build_focus_bundle(
            focus_nodes,
            ws_signal,
            branch_roles=get_branch_roles(root, branches),
        )
        focus_lines = tree_focus.format_focus_section(focus_bundle)
        if focus_lines and sum(len(x) + 1 for x in focus_lines) > int(focus_spot_budget * 0.72):
            focus_lines = tree_focus.format_focus_section(focus_bundle, max_inline_pages=1, max_inline_lines=8)
        if focus_lines and sum(len(x) + 1 for x in focus_lines) > int(focus_spot_budget * 0.80):
            focus_lines = tree_focus.format_focus_section(focus_bundle, max_inline_pages=0, max_inline_lines=0)

    def _fmt_extras(kind: str, location: str, origin: str = "self") -> str:
        parts: list[str] = []
        if origin == "external":
            parts.append("`[外部参考]`")
        elif origin == "mixed":
            parts.append("`[含外部参考]`")
        if kind == "idea":
            parts.append("💡想法")
        if location:
            parts.append(f"📍 `{location}`")
        return (" " + " ".join(parts)) if parts else ""

    # 2. Auto-Decay Activity Spotlight (computed from updated recency + audit.jsonl usage heat, zero manual tags)
    hot_items.sort(key=lambda x: (x[0], x[1], x[2].as_posix()), reverse=True)
    focus_chars = sum(len(x) + 1 for x in focus_lines)
    max_spot = 5 if (focus_chars + 1200) <= focus_spot_budget else 3
    spotlight_lines: list[str] = []
    for heat_score, eff_date, f, summary, active_days, kind, location, origin in hot_items[:max_spot]:
        icon = "🔥" if active_days >= 2 else "🕒"
        heat_tag = f" · 近30天活跃{active_days}天" if active_days >= 2 else ""
        spotlight_lines.append(
            f"- {icon} `{_rel_posix(f, root)}` [{eff_date.isoformat()}{heat_tag}]{_fmt_extras(kind, location, origin)} — {summary}"
        )

    if focus_lines:
        out.extend(focus_lines)

    if spotlight_lines:
        out.append(f"## 二、近期活跃焦点（按近 {recent_days} 天更新与读写热度自动排序）")
        out.extend(spotlight_lines)
        out.append("")

    # 3. Directory map of remaining active on-demand pages across all branches
    out.append("## 三、知识树全景目录（按需调用 `tree read` 加载具体页面）")
    current_chars = sum(len(x) + 1 for x in out)

    def _emit_entries_with_wiki_collapse(
        parent_dir: Path,
        entries: list[tuple[datetime.date, Path, str, str, str, str]],
        min_shown_before_budget: int,
        budget_msg_tpl: str,
    ) -> bool:
        """Render directory entries while collapsing `<subdir>/INDEX.md` folders (>= 3 pages) to one line."""
        nonlocal current_chars
        wiki_counts: dict[Path, int] = {}
        wiki_indexes: dict[Path, tuple[datetime.date, Path, str]] = {}
        for eff_date, f, summary, _kind, _location, _origin in entries:
            if f.parent != parent_dir and (f.parent / "INDEX.md").is_file():
                wiki_counts[f.parent] = wiki_counts.get(f.parent, 0) + 1
                if f.name.upper() == "INDEX.MD":
                    wiki_indexes[f.parent] = (eff_date, f, summary)
        collapsed = {d for d, cnt in wiki_counts.items() if cnt >= 3 and d in wiki_indexes}
        rendered_dirs: set[Path] = set()
        shown_lines = 0
        covered_entries = 0
        for eff_date, f, summary, kind, location, origin in entries:
            if f.parent in collapsed:
                if f.parent in rendered_dirs:
                    continue
                if current_chars >= DEFAULT_L0_MAX_CHARS and shown_lines >= min_shown_before_budget:
                    remain = max(1, len(entries) - covered_entries)
                    line = budget_msg_tpl.format(remain=remain)
                    out.append(line)
                    current_chars += len(line) + 1
                    return True
                rendered_dirs.add(f.parent)
                idx_date, idx_file, idx_sum = wiki_indexes[f.parent]
                rel_idx = _rel_posix(idx_file, root)
                cnt = wiki_counts[f.parent]
                line = f"  - 🗺️ `{rel_idx}` [{idx_date.isoformat()}] — {idx_sum}（Wiki 专题 · 含 {cnt} 篇互链页）"
                out.append(line)
                current_chars += len(line) + 1
                shown_lines += 1
                covered_entries += cnt
                continue
            if current_chars >= DEFAULT_L0_MAX_CHARS and shown_lines >= min_shown_before_budget:
                remain = max(1, len(entries) - covered_entries)
                line = budget_msg_tpl.format(remain=remain)
                out.append(line)
                current_chars += len(line) + 1
                return True
            rel = _rel_posix(f, root)
            line = f"  - `{rel}` [{eff_date.isoformat()}]{_fmt_extras(kind, location, origin)} — {summary}"
            out.append(line)
            current_chars += len(line) + 1
            shown_lines += 1
            covered_entries += 1
        return False

    for b, active_items, dormant_count, always_in_branch in branch_active_map:
        b_dir = root / b
        index_file = b_dir / "INDEX.md"
        index_active = False
        if index_file.is_file():
            try:
                _im, _ib, _id, idx_status, idx_age = get_page_meta_info(index_file)
                index_active = (idx_status not in DORMANT_STATUSES) and (idx_age <= stale_days)
            except Exception:
                index_active = False
        meta_parts: list[str] = []
        if always_in_branch:
            meta_parts.append(f"常驻 {always_in_branch} 篇")
        meta_parts.append(f"按需活跃 {len(active_items)} 篇" if always_in_branch else f"活跃 {len(active_items)} 篇")
        if dormant_count:
            meta_parts.append(f"休眠 {dormant_count} 篇")
        header_line = f"- **{b}/** ({' / '.join(meta_parts)})"
        out.append(header_line)
        current_chars += len(header_line) + 1
        branch_budget_exceeded = False
        if len(active_items) > 15 and index_active:
            rel_idx = _rel_posix(index_file, root)
            line = f"  - 🗺️ `{rel_idx}` — 活跃页面较多，请优先精读索引地图或使用 `tree search` 定位"
            out.append(line)
            current_chars += len(line) + 1
        else:
            branch_entries = [(eff_date, f, summary, kind, location, origin) for _h, eff_date, f, summary, _ad, _ag, kind, location, origin in active_items]
            branch_budget_exceeded = _emit_entries_with_wiki_collapse(
                b_dir,
                branch_entries,
                3,
                f"  - *（已达 L0 预算上限，余 {{remain}} 篇可用 `tree list \"{b}\"` 或 `tree search` 查看）*",
            )
        if dormant_count and not (len(active_items) > 15 and index_active) and not branch_budget_exceeded:
            line = f"  - *（另有 {dormant_count} 篇休眠或超过 {stale_days} 天未更新页面，仍可通过 `tree search` 召回）*"
            out.append(line)
            current_chars += len(line) + 1

    # Legacy `seed/` folder read support if still present on disk
    if active_seed_items or dormant_seed_count:
        seed_meta_parts = [f"待归并旧资料 {len(active_seed_items)} 篇"]
        if dormant_seed_count:
            seed_meta_parts.append(f"休眠 {dormant_seed_count} 篇")
        out.append(f"- **seed/** ({' / '.join(seed_meta_parts)})")
        seed_entries = [(sf_date, sf, sf_sum, "", "", "external") for sf, sf_date, sf_sum in active_seed_items]
        _emit_entries_with_wiki_collapse(
            seed_dir,
            seed_entries,
            2,
            "  - *（已达 L0 预算上限，余 {remain} 篇可用 `tree seed status` 查看）*",
        )

    staged_files = tree_seed.list_staging_files(root)
    if staged_files:
        out.append("")
        out.append(f"> 🌱 采集暂存区 `.tree/staging/` 存在 {len(staged_files)} 份待蒸馏素材（查看: `tree seed status` | 读总览: `.tree/staging/00-manifest.md`）。")

    print("\n".join(out))


def cmd_list(root: Path, args: argparse.Namespace) -> None:
    target = safe_resolve(root, args.subpath) if args.subpath else root
    if not target.exists():
        print(f"❌ 路径不存在: {args.subpath}", file=sys.stderr)
        sys.exit(1)
    log_audit(root, "list", args.subpath or "/")

    def fmt_meta(f: Path) -> str:
        meta, _, eff_date, status, _ = get_page_meta_info(f)
        tags = [eff_date.isoformat()]
        if f.name == "SKILL.md":
            tags.append("🧩skill")
        if status != "active":
            tags.append(status)
        if meta.get("kind"):
            tags.append(meta["kind"].strip().lower())
        loc = f" 📍 {meta['location'].strip()}" if meta.get("location") else ""
        return f"[{' · '.join(tags)}]{loc}"

    if args.subpath:
        files = _iter_branch_pages(root, target) if target.is_dir() else [target]
        for f in files:
            rel = _rel_posix(f, root)
            print(f"📄 {rel} {fmt_meta(f)} ({extract_first_summary(f)})")
    else:
        for b in [*get_branches(root), "seed"]:
            b_dir = root / b
            if not b_dir.exists():
                continue
            files = _iter_branch_pages(root, b_dir)
            icon = "🌱" if b == "seed" else "🌳"
            print(f"{icon} {b}/ ({len(files)} 篇)")
            for f in files:
                rel_in_b = f.relative_to(b_dir).as_posix()
                print(f"   └── {rel_in_b} {fmt_meta(f)} — {extract_first_summary(f)}")


def _resolve_existing_page(root: Path, raw_path: str, allow_short_name: bool = False) -> tuple[Path | None, list[str]]:
    """Resolve an existing page path, tolerating omitted `.md` and (when reading) unique `[[wikilink]]` short names."""
    cleaned = raw_path.strip().replace("\\", "/").lstrip("/")
    if cleaned.startswith("[[") and cleaned.endswith("]]"):
        inner = cleaned[2:-2].split("|", 1)[0].strip()
        # Try full string first (in case filename itself contains `#`), then strip `#anchor`
        inner_candidates = [inner]
        if "#" in inner:
            inner_candidates.append(inner.split("#", 1)[0].strip())
        cleaned = inner_candidates[0]
    else:
        inner_candidates = [cleaned]

    for cand_base in inner_candidates:
        cands = [cand_base]
        if cand_base and not cand_base.endswith(".md"):
            cands.append(cand_base + ".md")
        for cand in cands:
            p = safe_resolve(root, cand)
            if p.exists() and p.is_file():
                return p, []
    if not allow_short_name or not cleaned:
        return None, []

    search_branches = [*get_branches(root), "seed"] if (root / "seed").is_dir() else get_branches(root)
    for cand_base in inner_candidates:
        target_key = cand_base[:-3] if cand_base.endswith(".md") else cand_base
        matches: list[Path] = []
        for b in search_branches:
            b_dir = root / b
            if not b_dir.is_dir():
                continue
            for f in _iter_branch_pages(root, b_dir):
                rel = _rel_posix(f, root)
                rel_no_ext = rel[:-3] if rel.endswith(".md") else rel
                parts = Path(rel_no_ext).parts
                folder_stem = f"{parts[-2]}/{f.stem}" if len(parts) >= 3 else ""
                if target_key in {rel, rel_no_ext, folder_stem, f.stem}:
                    matches.append(f)
        if len(matches) == 1:
            return matches[0], []
        if len(matches) > 1:
            return None, [_rel_posix(m, root) for m in matches]
    return None, []


def cmd_read(root: Path, args: argparse.Namespace) -> None:
    target, ambiguous = _resolve_existing_page(root, args.path, allow_short_name=True)
    if not target:
        if ambiguous:
            print(f"❌ 路径 `{args.path}` 命中多篇同名页面，请指定完整路径：", file=sys.stderr)
            for m in ambiguous[:8]:
                print(f"  - {m}", file=sys.stderr)
        else:
            print(f"❌ 页面不存在: {args.path}", file=sys.stderr)
        sys.exit(1)
    rel = _rel_posix(target, root)
    detail = f"sha256:{get_readme_hash(target)}" if rel.lower() == "readme.md" else ""
    log_audit(root, "read", rel, agent=args.agent, detail=detail)
    print(target.read_text(encoding="utf-8"))


def extract_custom_rules(readme_text: str) -> list[str]:
    """Extract user-authored lines under section '五、我的个性化定制规则'."""
    in_section = False
    collected: list[str] = []
    for raw in readme_text.splitlines():
        line = raw.strip()
        if not in_section:
            if re.match(r"^##\s+.*个性化定制规则\s*$", line):
                in_section = True
            continue
        if line.startswith("## ") or line == "---":
            break
        if not line or line.startswith(">"):
            continue
        if "暂无额外定制" in line:
            continue
        collected.append(raw.rstrip())
    return collected


def strip_empty_custom_section(readme_text: str) -> str:
    """Remove empty '我的个性化定制规则' section placeholder for compact `tree rules` output."""
    lines = readme_text.splitlines()
    out: list[str] = []
    i = 0
    while i < len(lines):
        if re.match(r"^##\s+.*个性化定制规则\s*$", lines[i].strip()):
            section_end = i + 1
            while section_end < len(lines):
                s = lines[section_end].strip()
                if s.startswith("## ") or s == "---":
                    break
                section_end += 1
            if not extract_custom_rules("\n".join(lines[i:section_end])):
                while out and out[-1].strip() in ("", "---"):
                    out.pop()
                i = section_end
                if i < len(lines) and lines[i].strip() == "---":
                    i += 1
                continue
        out.append(lines[i])
        i += 1
    return "\n".join(out).strip()


def cmd_rules(root: Path, args: argparse.Namespace) -> None:
    readme_path = find_readme_path(root)
    if not readme_path:
        print("❌ 根目录未找到 README.md 维护准则", file=sys.stderr)
        sys.exit(1)
    rel = _rel_posix(readme_path, root)
    readme_text = readme_path.read_text(encoding="utf-8")
    log_audit(root, "read", rel, agent=args.agent, detail=f"sha256:{get_readme_hash(readme_path)}")
    branches = get_branches(root)
    footer = (
        f"\n\n---\n"
        f"- **当前运行态**：知识库路径 `{root}` | 启用主干 `{', '.join(branches)}`\n"
        f"- **最小写入速查**：`cat <<'EOF' | tree write \"<相对路径>.md\" --reason \"<原因>\"`（自动读管道正文并合并保留旧 YAML 元数据；常用：`--always` / `--origin` / `--source` / `--append` / `--force`；移动：`tree move \"<旧>\" \"<新>\" --reason \"<原因>\"`；删除：`tree delete \"<路径>\" --reason \"<原因>\"`）"
    )
    body = readme_text.strip() if getattr(args, "full", False) else strip_empty_custom_section(readme_text)
    print(body + footer)


def _validate_write_rel_path(rel_clean: str) -> None:
    """Block writing to reserved system dirs (`.git`, `.tree`, `outputs`, etc.) and stray root files other than README.md."""
    if rel_clean.lower() == "readme.md":
        return
    parts = [p for p in rel_clean.split("/") if p]
    if len(parts) < 2:
        raise ValueError(f"禁止在知识库根目录写入散落文件 `{rel_clean}`，请归类到一级主干目录（如 `02-我的思考/{rel_clean}`）")
    top = parts[0]
    write_blocked_top = (RESERVED_TOP_DIRS - {"seed"})
    if top.startswith(".") or top in write_blocked_top:
        extra_hint = "（快变量与衍生文件请直接写入磁盘，勿用 `tree write` 入树）" if top == "outputs" else ""
        raise ValueError(f"禁止向系统保留目录 `{top}/` 写入内容页{extra_hint}")
    if any(p.startswith(".") for p in parts):
        raise ValueError(f"禁止向隐藏路径 `{rel_clean}` 写入内容页")


def cmd_write(root: Path, args: argparse.Namespace) -> None:
    agent = _resolve_caller_agent(args.agent)
    verify_readme_gate(root, agent=agent)
    rel_clean = args.path.strip().replace("\\", "/").lstrip("/")
    if not rel_clean or rel_clean.endswith("/"):
        print(f"❌ 目标路径必须指向具体的 Markdown 文件: `{args.path}`", file=sys.stderr)
        sys.exit(1)
    if not rel_clean.endswith(".md"):
        rel_clean += ".md"
    if Path(rel_clean).name.lower() == "readme.md" and "/" in rel_clean:
        print("❌ 违反园丁契约：正文必须写在具名专页中，禁止写入子目录 README.md", file=sys.stderr)
        sys.exit(1)
    _validate_write_rel_path(rel_clean)

    target = safe_resolve(root, rel_clean)
    if args.stdin or (not (args.content or "").strip() and not sys.stdin.isatty()):
        content = sys.stdin.read()
    else:
        content = args.content or ""
    if not content.strip():
        print("❌ 写入内容不能为空", file=sys.stderr)
        sys.exit(1)

    existed = target.exists()
    is_append = bool(getattr(args, "append", False))
    is_force = bool(getattr(args, "force", False))
    if existed and rel_clean.lower() != "readme.md":
        old_raw = target.read_text(encoding="utf-8")
        old_meta, old_body = parse_frontmatter(old_raw)
        incoming_meta, incoming_body = parse_frontmatter(content)
        old_span = _extract_frontmatter_span(old_raw)
        if is_append:
            # Preserve existing frontmatter (merging any incoming frontmatter keys) + body and append cleanly
            combined_body = f"{old_body.rstrip()}\n\n{incoming_body.strip()}" if old_body.strip() else incoming_body.strip()
            in_span = _extract_frontmatter_span(content)
            if in_span and old_span:
                norm_in, in_end, _ = in_span
                in_fm_only = norm_in[: in_end + 4] + "\n\n" + combined_body + "\n"
                content = _merge_frontmatter_blocks(old_raw, in_fm_only)
            elif in_span:
                norm_in, in_end, _ = in_span
                content = norm_in[: in_end + 4] + "\n\n" + combined_body + "\n"
            elif old_span:
                norm_old, fm_end, _ = old_span
                fm_header = norm_old[: fm_end + 4]
                content = f"{fm_header}\n\n{combined_body}\n"
            else:
                content = combined_body
        else:
            if not is_force:
                old_len = len(old_body.strip())
                new_len = len(incoming_body.strip())
                if old_len >= 200 and new_len < old_len * 0.5:
                    print(
                        f"❌ 防截断保护拦截：`{rel_clean}` 原文正文 {old_len} 字符，本次写入仅 {new_len} 字符（缩水超过 50%），疑似截断或省略了旧内容。",
                        file=sys.stderr,
                    )
                    print("👉 若仅补充新内容请改用 `--append`；若确需大幅精简或重写整页请附带 `--force`。", file=sys.stderr)
                    sys.exit(1)
            # Key-level merge existing YAML frontmatter so partial updates never silently wipe untouched fields
            if old_meta and old_span:
                content = _merge_frontmatter_blocks(old_raw, content)
    elif existed and rel_clean.lower() == "readme.md":
        old_raw = target.read_text(encoding="utf-8")
        if is_append:
            content = f"{old_raw.rstrip()}\n\n{content.strip()}"
        elif not is_force:
            old_len = len(old_raw.strip())
            new_len = len(content.strip())
            if old_len >= 200 and new_len < old_len * 0.5:
                print(
                    f"❌ 防截断保护拦截：`{rel_clean}` 原文 {old_len} 字符，本次写入仅 {new_len} 字符（缩水超过 50%）。",
                    file=sys.stderr,
                )
                print("👉 若仅补充内容请改用 `--append`；若确需大幅重写请附带 `--force`。", file=sys.stderr)
                sys.exit(1)

    if rel_clean.lower() != "readme.md":
        today_str = datetime.datetime.now().date().isoformat()
        status_arg = getattr(args, "status", "") or ""
        always_arg: bool | None = None
        if getattr(args, "always", False):
            always_arg = True
        elif getattr(args, "no_always", False):
            always_arg = False
        content = upsert_frontmatter(
            content,
            today_str,
            status=status_arg,
            kind=getattr(args, "kind", "") or "",
            location=getattr(args, "location", "") or "",
            when=getattr(args, "when", "") or "",
            always=always_arg,
            origin=getattr(args, "origin", "") or "",
            source=getattr(args, "source", "") or "",
        )
    else:
        content = content.rstrip() + "\n"

    atomic_write_text(target, content)

    action = "update" if existed else "create"
    rel_str = _rel_posix(target, root)
    rel_parts = Path(rel_str).parts
    cfg_updated = _sync_branch_into_config(root, rel_parts[0]) if len(rel_parts) >= 2 else False
    reason = args.reason or ("更新上下文页面" if existed else "新增上下文页面")

    meta = ensure_meta_dir(root)
    append_jsonl(
        meta / "changelog.jsonl",
        {
            "timestamp": now_iso(),
            "action": action,
            "path": rel_str,
            "agent": agent,
            "reason": reason,
        },
    )
    log_audit(root, f"write:{action}", rel_str, agent=agent, detail=reason)
    # Refresh README gate stamp for the authoring agent so editing README.md doesn't immediately lock out follow-up writes
    if rel_str.lower() == "readme.md":
        log_audit(root, "read", rel_str, agent=agent, detail=f"sha256:{get_readme_hash(target)}")
    commit_paths: str | list[str] = [rel_str, ".tree/config.json"] if cfg_updated else rel_str
    git_ok, git_err = git_commit_change(root, commit_paths, action, reason, agent)
    if git_ok:
        print(f"✅ 已{'更新' if existed else '创建'} `{rel_str}` 并完成 Git 版本提交 ({reason})")
    else:
        print(f"✅ 已{'更新' if existed else '创建'} `{rel_str}`（⚠️ Git 提交失败: {git_err}）", file=sys.stderr)
    auto_refresh_global_instructions_if_mounted(root)

    if rel_str.lower() != "readme.md":
        written_meta, written_body = parse_frontmatter(content)
        parts = Path(rel_str).parts
        top_branch = parts[0] if parts else ""
        if is_always_loaded(written_meta):
            non_empty_cnt = len([ln for ln in written_body.strip().splitlines() if ln.strip()])
            if non_empty_cnt > 45:
                print(
                    f"⚠️ 提示：常驻页 `{rel_str}` 有效正文达 {non_empty_cnt} 行（超 45 行上限），L0 与宿主全局指令中将被截断，建议精简或拆分按需页。"
                )
        generic_when = _detect_generic_when_tokens(written_meta.get("when", ""))
        if generic_when:
            print(
                f"⚠️ 提示：`when:` 含高泛化词（{', '.join(generic_when)}），容易在无关对话中误触发对焦，建议改用高区分度专词或留空。"
            )
        active_branches = get_branch_roles(root).get("active", set())
        if top_branch in active_branches and not written_meta.get("kind"):
            print("💡 提示：推进中事项页建议补充 `--kind idea` 或 `--kind project --location \"<外部路径或链接>\"`")


def _find_backlinks(root: Path, rel_str: str) -> list[str]:
    """Find pages referencing `rel_str` via [[wikilinks]] outside code blocks."""
    rel_no_ext = rel_str[:-3] if rel_str.endswith(".md") else rel_str
    parts = Path(rel_no_ext).parts
    stem = parts[-1] if parts else ""
    folder_stem = f"{parts[-2]}/{stem}" if len(parts) >= 3 else ""
    keys = {k for k in (rel_str, rel_no_ext, folder_stem, stem) if k}
    fenced_re = re.compile(r"```.*?```", re.DOTALL)
    inline_re = re.compile(r"`[^`\n]+`")
    referrers: list[str] = []
    for b in [*get_branches(root), "seed"]:
        b_dir = root / b
        if not b_dir.is_dir():
            continue
        for md in _iter_branch_pages(root, b_dir):
            md_rel = _rel_posix(md, root)
            if md_rel == rel_str:
                continue
            try:
                text = md.read_text(encoding="utf-8", errors="ignore")
            except Exception:
                continue
            _, body = parse_frontmatter(text)
            cleaned = inline_re.sub("", fenced_re.sub("", body))
            for raw_t in tree_focus.WIKILINK_RE.findall(cleaned):
                t = raw_t.strip()
                t_no_ext = t[:-3] if t.endswith(".md") else t
                if t in keys or t_no_ext in keys:
                    referrers.append(md_rel)
                    break
    return referrers


def cmd_delete(root: Path, args: argparse.Namespace) -> None:
    agent = _resolve_caller_agent(args.agent)
    verify_readme_gate(root, agent=agent)
    raw_clean = args.path.strip().replace("\\", "/").lstrip("/")
    target = safe_resolve(root, raw_clean)
    if not target.exists() and not raw_clean.endswith(".md"):
        alt = safe_resolve(root, raw_clean + ".md")
        if alt.exists():
            target = alt
    if not target.exists():
        print(f"❌ 路径不存在: {args.path}", file=sys.stderr)
        sys.exit(1)
    if target.is_dir():
        print(f"❌ 不支持直接删除目录: `{args.path}`，请逐页指定文件或使用 `tree move`", file=sys.stderr)
        sys.exit(1)
    rel_str = _rel_posix(target, root)
    rel_parts = Path(rel_str).parts
    top_dir = rel_parts[0] if rel_parts else ""
    if (
        rel_str in get_branches(root)
        or rel_str.lower() == "readme.md"
        or top_dir.startswith(".")
        or top_dir in (RESERVED_TOP_DIRS - {"seed"})
        or any(p.startswith(".") for p in rel_parts)
    ):
        print(f"❌ 严禁删除系统保留文件、隐藏元数据、一级主干或根契约: `{rel_str}`", file=sys.stderr)
        sys.exit(1)

    backlinks = _find_backlinks(root, rel_str)
    target.unlink()
    reason = args.reason or "修剪过期或已合并页面"
    meta = ensure_meta_dir(root)
    append_jsonl(
        meta / "changelog.jsonl",
        {
            "timestamp": now_iso(),
            "action": "delete",
            "path": rel_str,
            "agent": agent,
            "reason": reason,
        },
    )
    log_audit(root, "delete", rel_str, agent=agent, detail=reason)
    git_ok, git_err = git_commit_change(root, rel_str, "delete", reason, agent)
    if git_ok:
        print(f"🗑️ 已修剪删除 `{rel_str}` 并记录 Git 版本历史")
    else:
        print(f"🗑️ 已修剪删除 `{rel_str}`（⚠️ Git 提交失败: {git_err}）", file=sys.stderr)
    if backlinks:
        print(f"⚠️ 提醒：以下 {len(backlinks)} 篇页面仍存在指向该页的 [[双链]]，请按需更新或清理：{', '.join(backlinks[:8])}")
    auto_refresh_global_instructions_if_mounted(root)


def _replace_wikilinks(root: Path, src_rel: str, dst_rel: str) -> list[str]:
    """Update path-based and stem-based [[wikilinks]] outside code blocks across Markdown pages after a move."""
    src_no_ext = src_rel[:-3] if src_rel.endswith(".md") else src_rel
    dst_no_ext = dst_rel[:-3] if dst_rel.endswith(".md") else dst_rel
    src_path = Path(src_no_ext)
    dst_path = Path(dst_no_ext)
    pairs: list[tuple[str, str]] = [(src_rel, dst_rel), (src_no_ext, dst_no_ext)]
    if len(src_path.parts) >= 2 and len(dst_path.parts) >= 2:
        src_short = f"{src_path.parts[-2]}/{src_path.name}"
        dst_short = f"{dst_path.parts[-2]}/{dst_path.name}"
        if src_short != dst_short:
            pairs.append((src_short, dst_short))
        if src_path.name != dst_path.name:
            # Prefer disambiguated Parent/Stem link when target stem is generic (e.g. 项目总览 / INDEX)
            target_link = dst_short if dst_path.name in {"项目总览", "总览", "概览", "INDEX"} else dst_path.name
            pairs.append((src_path.name, target_link))
    elif src_path.name != dst_path.name:
        pairs.append((src_path.name, dst_path.name))

    def _apply_pairs(chunk: str) -> str:
        res = chunk
        for old_ref, new_ref in pairs:
            res = res.replace(f"[[{old_ref}]]", f"[[{new_ref}]]")
            res = res.replace(f"[[{old_ref}|", f"[[{new_ref}|")
            res = res.replace(f"[[{old_ref}#", f"[[{new_ref}#")
        return res

    updated_files: list[str] = []
    for branch in [*get_branches(root), "seed"]:
        b_dir = root / branch
        if not b_dir.exists():
            continue
        for md in _iter_branch_pages(root, b_dir):
            try:
                text = md.read_text(encoding="utf-8")
            except Exception:
                continue
            new_text = _replace_outside_code(text, _apply_pairs)
            if new_text != text:
                atomic_write_text(md, new_text)
                updated_files.append(_rel_posix(md, root))
    return updated_files


def cmd_move(root: Path, args: argparse.Namespace) -> None:
    agent = _resolve_caller_agent(args.agent)
    verify_readme_gate(root, agent=agent)
    src_clean = args.src.strip().replace("\\", "/").lstrip("/")
    src = safe_resolve(root, src_clean)
    if not src.exists() and not src_clean.endswith(".md"):
        src_clean += ".md"
        src = safe_resolve(root, src_clean)
    if not src.exists() or not src.is_file():
        print(f"❌ 源文件不存在或不是文件: {args.src}", file=sys.stderr)
        sys.exit(1)

    src_rel = _rel_posix(src, root)
    if src_rel in get_branches(root) or src_rel.lower() == "readme.md":
        print("❌ 严禁移动一级主干目录或根契约 README.md", file=sys.stderr)
        sys.exit(1)

    raw_dst = args.dst.strip().replace("\\", "/").lstrip("/")
    if not raw_dst or raw_dst.endswith("/"):
        print(f"❌ 目标路径必须包含具体文件名（不能以 `/` 结尾）: `{args.dst}`", file=sys.stderr)
        sys.exit(1)
    raw_dst_resolved = safe_resolve(root, raw_dst)
    if raw_dst_resolved.exists() and raw_dst_resolved.is_dir():
        print(f"❌ 目标路径是已存在的目录，请指定完整目标文件路径（如 `{raw_dst}/{src.name}`）", file=sys.stderr)
        sys.exit(1)

    dst_clean = raw_dst
    if not dst_clean.endswith(".md"):
        dst_clean += ".md"
    if Path(dst_clean).name.lower() == "readme.md":
        print("❌ 违反园丁契约：禁止移动或写入子目录 README.md", file=sys.stderr)
        sys.exit(1)
    _validate_write_rel_path(dst_clean)
    dst = safe_resolve(root, dst_clean)
    if dst.resolve() == src.resolve():
        print("ℹ️ 源路径与目标路径相同，无需移动。")
        return

    if dst.exists() and not getattr(args, "force", False):
        print(f"❌ 目标路径已存在: `{_rel_posix(dst, root)}`（如需覆盖请加 --force）", file=sys.stderr)
        sys.exit(1)
    if dst.exists() and dst.is_dir():
        print(f"❌ 目标路径是目录，无法覆盖: `{_rel_posix(dst, root)}`", file=sys.stderr)
        sys.exit(1)

    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists():
        dst.unlink()
    src.rename(dst)
    dst_rel = _rel_posix(dst, root)
    dst_parts = Path(dst_rel).parts
    cfg_updated = _sync_branch_into_config(root, dst_parts[0]) if len(dst_parts) >= 2 else False

    link_updates = _replace_wikilinks(root, src_rel, dst_rel)

    reason = args.reason or "重命名或迁移上下文页面"
    meta = ensure_meta_dir(root)
    append_jsonl(
        meta / "changelog.jsonl",
        {
            "timestamp": now_iso(),
            "action": "move",
            "path": f"{src_rel} -> {dst_rel}",
            "agent": agent,
            "reason": reason,
        },
    )
    log_audit(root, "move", f"{src_rel} -> {dst_rel}", agent=agent, detail=reason)

    move_commit_paths = [src_rel, dst_rel, *link_updates]
    if cfg_updated:
        move_commit_paths.append(".tree/config.json")
    git_ok, git_err = git_commit_change(root, move_commit_paths, "move", reason, agent)
    if git_ok:
        print(f"✅ 已移动 `{src_rel}` -> `{dst_rel}` 并完成 Git 提交 ({reason})")
    else:
        print(f"✅ 已移动 `{src_rel}` -> `{dst_rel}`（⚠️ Git 提交失败: {git_err}）", file=sys.stderr)
    if link_updates:
        print(f"🔗 已同步更新 {len(link_updates)} 个关联页面中的 [[双链]]")
    auto_refresh_global_instructions_if_mounted(root)


def cmd_recent(root: Path, args: argparse.Namespace) -> None:
    """Dynamically filter recent active thoughts/work by updated recency & audit usage heat."""
    days = args.days if args.days is not None else get_l0_recent_days(root)
    if days < 0:
        print("❌ `--days` 必须为非负整数（0 表示全部活跃页面）", file=sys.stderr)
        sys.exit(1)
    stale_days = get_l0_stale_days(root)
    log_audit(root, "recent", f"days={days}")
    branches = get_branches(root)
    identity_set = set(get_identity_branches(root, branches))
    l0_excluded = get_l0_excluded(root)
    usage_window = days if days > 0 else HEAT_AUDIT_WINDOW_DAYS
    usage_map = load_recent_audit_usage(root, window_days=usage_window)

    rows: list[tuple[float, datetime.date, str, int, str]] = []
    for b in branches:
        if b in l0_excluded:
            continue
        b_dir = root / b
        if not b_dir.exists():
            continue
        for f in _iter_branch_pages(root, b_dir):
            meta, _body, eff_date, status, age_days = get_page_meta_info(f)
            if status in DORMANT_STATUSES or age_days > stale_days or is_always_loaded(meta, b, identity_set):
                continue
            rel = _rel_posix(f, root)
            kind = (meta.get("kind") or "").strip().lower()
            origin = (meta.get("origin") or "self").strip().lower() or "self"
            heat_score, active_days = compute_page_heat(rel, age_days, kind, usage_map, origin=origin)
            if days > 0 and age_days > days and active_days == 0:
                continue
            rows.append((heat_score, eff_date, rel, active_days, extract_first_summary(f)))

    rows.sort(key=lambda r: (r[0], r[1], r[2]), reverse=True)
    title = (
        f"🕒 最近 {days} 天活跃焦点（按更新与读写热度排序）"
        if days > 0
        else f"🕒 全部活跃页面（{stale_days} 天内，按热度排序）"
    )
    print(f"{title}（共 {len(rows)} 篇）:\n")
    if not rows:
        print("  (暂无符合条件的活跃页面)")
        return
    for _heat, eff_date, rel, active_days, summary in rows:
        icon = "🔥" if active_days >= 2 else "🕒"
        htag = f" · 活跃{active_days}天" if active_days >= 2 else ""
        print(f"  {icon} {rel} [{eff_date.isoformat()}{htag}] — {summary}")


def _has_tag(meta: dict[str, str], body: str, tag_query: str) -> bool:
    """Return whether a page has the given tag in frontmatter `tags` or inline `#tag`."""
    needle = tag_query.strip().lstrip("#").lower()
    if not needle:
        return True
    tags_raw = meta.get("tags", "").strip().lower()
    if tags_raw:
        tokens = [t.strip(" []'\"#") for t in re.split(r"[,，\s]+", tags_raw) if t.strip()]
        if needle in tokens:
            return True
    cleaned_body = re.sub(r"```.*?```", "", body, flags=re.DOTALL)
    cleaned_body = re.sub(r"`[^`\n]+`", "", cleaned_body)
    return bool(
        re.search(
            rf"(?:^|[\s（(【\[「『，。；、,:：]|[\u4e00-\u9fff])#{re.escape(needle)}(?:\s|$|[，。；、,.!?:;）)\]】」』])",
            cleaned_body,
            re.MULTILINE | re.IGNORECASE,
        )
    )


def cmd_search(root: Path, args: argparse.Namespace) -> None:
    q = (getattr(args, "query", "") or "").strip().lower()
    kind_f = (getattr(args, "kind", "") or "").strip().lower()
    status_f = (getattr(args, "status", "") or "").strip().lower()
    tag_f = (getattr(args, "tag", "") or "").strip().lower()
    always_f = (getattr(args, "always", "") or "").strip().lower()
    origin_f = (getattr(args, "origin", "") or "").strip().lower()
    branch_f = (getattr(args, "branch", "") or "").strip().lower()

    if not any([q, kind_f, status_f, tag_f, always_f, origin_f, branch_f]):
        print("❌ 请提供搜索关键词或至少一个元数据筛选参数（如 `--kind idea` / `--status archived` / `--origin external` / `--tag note`）。", file=sys.stderr)
        sys.exit(1)

    log_audit(
        root,
        "search",
        q or "*",
        detail=f"kind={kind_f},status={status_f},tag={tag_f},always={always_f},origin={origin_f},branch={branch_f}",
    )
    branches = get_branches(root)
    identity_set = set(get_identity_branches(root, branches))
    matches: list[tuple[datetime.date, str, list[str], str, str]] = []
    searchable_branches = [*branches, "seed"] if (root / "seed").is_dir() else list(branches)

    for b in searchable_branches:
        if branch_f and not b.lower().startswith(branch_f):
            continue
        b_dir = root / b
        if not b_dir.exists():
            continue
        for f in _iter_branch_pages(root, b_dir, include_readme=True):
            if f.name.lower() == "readme.md" and not q:
                continue
            text = f.read_text(encoding="utf-8")
            meta, body, eff_date, status, _ = get_page_meta_info(f, text)
            default_origin = "external" if b == "seed" else "self"
            page_origin = (meta.get("origin") or default_origin).strip().lower() or default_origin
            if kind_f and (meta.get("kind") or "").strip().lower() != kind_f:
                continue
            if status_f and status != status_f:
                continue
            if tag_f and not _has_tag(meta, body, tag_f):
                continue
            if always_f:
                want_always = always_f == "true"
                if is_always_loaded(meta, b, identity_set) != want_always:
                    continue
            if origin_f and page_origin != origin_f:
                continue
            if q and q not in f.name.lower() and q not in text.lower():
                continue

            rel = _rel_posix(f, root)
            badges = [eff_date.isoformat()]
            if page_origin == "external":
                badges.append("外部参考")
            elif page_origin == "mixed":
                badges.append("含外部参考")
            if status != "active":
                badges.append(status)
            if meta.get("kind"):
                badges.append(meta["kind"].strip().lower())
            if meta.get("location"):
                badges.append(f"📍 {meta['location'].strip()}")
            tag = "[" + " · ".join(badges) + "]"

            lines_hit = (
                [
                    f"   L{idx}: {line.strip()[:100]}"
                    for idx, line in enumerate(text.splitlines(), 1)
                    if q in line.lower()
                ]
                if q
                else []
            )
            summary = "" if lines_hit else extract_first_summary(f)
            matches.append((eff_date, rel, lines_hit, tag, summary))

    matches.sort(key=lambda item: (item[0], item[1]), reverse=True)
    for _, rel, lines_hit, tag, summary in matches:
        tail = f" — {summary}" if summary else ""
        print(f"🔍 {rel} {tag}{tail}")
        for lh in lines_hit:
            print(lh)
    if not matches:
        print("未找到符合条件的上下文专页。")


def _collect_tree_lint(root: Path) -> tuple[list[str], list[str]]:
    """Collect knowledge tree health errors and warnings."""
    branches = get_branches(root)
    warnings: list[str] = []
    errors: list[str] = []
    stem_locations: dict[str, list[str]] = {}

    fragment_re = re.compile(r"(补充|其他|讨论记录|方案\d+|最新)\.md$")
    diary_patterns = ("用户在对话中", "用户提到", "用户表示", "本次对话中", "对话记录显示")
    lint_branches = [*branches, "seed"] if (root / "seed").is_dir() else list(branches)
    fenced_code_re = re.compile(r"```.*?```", re.DOTALL)
    inline_code_re = re.compile(r"`[^`\n]+`")
    placeholder_links = {"双链", "wikilink", "wikilinks", "目标", "页面", "页面名", "xxx"}

    # Pre-index all existing pages for wikilink & Wiki orphan-page checks
    known_link_targets: set[str] = set()
    page_records: list[tuple[str, Path, Path, str, str]] = []  # (rel, path, branch_dir, body, text)
    for b in lint_branches:
        b_dir = root / b
        if not b_dir.exists():
            continue
        for f in _iter_branch_pages(root, b_dir):
            rel = _rel_posix(f, root)
            rel_no_ext = rel[:-3] if rel.endswith(".md") else rel
            known_link_targets.add(rel)
            known_link_targets.add(rel_no_ext)
            known_link_targets.add(f.stem)
            rel_parts = Path(rel).parts
            if len(rel_parts) >= 3:
                known_link_targets.add(f"{rel_parts[-2]}/{f.stem}")
            text = f.read_text(encoding="utf-8", errors="ignore")
            _, body = parse_frontmatter(text)
            page_records.append((rel, f, b_dir, body, text))

    inbound_refs: set[str] = set()
    wikilink_checks: list[tuple[str, str]] = []  # (source_rel, target)

    for rel, f, b_dir, body, _text in page_records:
        cleaned = inline_code_re.sub("", fenced_code_re.sub("", body))
        for raw_target in tree_focus.WIKILINK_RE.findall(cleaned):
            target = raw_target.strip()
            if not target or target.lower() in placeholder_links:
                continue
            target_no_ext = target[:-3] if target.endswith(".md") else target
            wikilink_checks.append((rel, target))
            inbound_refs.add(target)
            inbound_refs.add(target_no_ext)
            # Only treat bare links (no `/`) as folder-agnostic stem references so `专题一/子页A` never masks orphan `专题二/子页A`
            if "/" not in target_no_ext:
                inbound_refs.add(target_no_ext)

    for rel, target in wikilink_checks:
        target_no_ext = target[:-3] if target.endswith(".md") else target
        if target not in known_link_targets and target_no_ext not in known_link_targets:
            warnings.append(f"[断链] `{rel}` 中的 `[[{target}]]` 未找到对应专页")

    for b in lint_branches:
        b_dir = root / b
        if not b_dir.exists():
            continue
        # Empty subdirectories
        for d in sorted(p for p in b_dir.rglob("*") if p.is_dir()):
            if b == "seed" and d.relative_to(b_dir).parts[0] == "staging":
                continue
            if not any(d.iterdir()):
                warnings.append(f"[空目录] `{_rel_posix(d, root)}` 为空目录，建议清理")

        for f in _iter_branch_pages(root, b_dir, include_readme=True):
            rel = _rel_posix(f, root)
            if f.name.lower() == "readme.md":
                errors.append(f"[子目录 README] `{rel}` 违反契约：正文不可写在子目录 README.md")
                continue
            is_skill_entry = (f.name == "SKILL.md")
            rel_parts = Path(rel).parts
            if len(rel_parts) > 4:
                warnings.append(f"[路径过深] `{rel}` 深度达 {len(rel_parts)} 层（建议不超过 4 层）")
            if not is_skill_entry:
                # Files inside a dedicated 3rd-level project/topic subfolder (e.g. 03-我正在做的事/工作/Eden/项目总览.md)
                # are namespaced by their parent folder (`Eden/项目总览`) so clean short filenames don't collide.
                stem_key = f"{rel_parts[-2]}/{f.stem}" if len(rel_parts) >= 4 else f.stem
                stem_locations.setdefault(stem_key, []).append(rel)
            if fragment_re.search(f.name):
                warnings.append(f"[碎片命名] `{rel}` 疑似临时碎片文件，建议原地融合到主专页")

            text = f.read_text(encoding="utf-8", errors="ignore")
            page_meta, body = parse_frontmatter(text)
            page_origin = (page_meta.get("origin") or "self").strip().lower()
            if page_origin in {"external", "mixed"} and not (page_meta.get("source") or "").strip():
                if not re.search(r"https?://|整理自|编译自|来自|出处", body):
                    warnings.append(f"[缺少出处] `{rel}` 标为 `origin: {page_origin}`，建议补充 `source:` 元数据或出处链接")
            non_empty = [ln for ln in body.splitlines() if ln.strip()]
            if len(non_empty) < 3:
                warnings.append(f"[过短页面] `{rel}` 仅 {len(non_empty)} 行有效内容，疑似碎片短页")
            elif len(body.splitlines()) > 300:
                warnings.append(f"[超长页面] `{rel}` 达 {len(body.splitlines())} 行，若主题分叉建议拆分互链")
            if is_always_loaded(page_meta) and len(non_empty) > 45:
                warnings.append(f"[常驻超长] `{rel}` 标为 `always: true` 但有效正文达 {len(non_empty)} 行（超 45 行将被截断）")
            generic_when = _detect_generic_when_tokens(page_meta.get("when", ""))
            if generic_when:
                warnings.append(f"[when 泛词风险] `{rel}` 的 `when:` 含高泛化词（{', '.join(generic_when)}），易导致无关场景误触发")

            # Wiki orphan-page check: inside a subfolder with INDEX.md, every non-INDEX page should have >= 1 inbound [[link]]
            if f.parent != b_dir and (f.parent / "INDEX.md").is_file() and f.name.upper() != "INDEX.MD" and not is_skill_entry:
                rel_no_ext = rel[:-3] if rel.endswith(".md") else rel
                folder_stem = f"{f.parent.name}/{f.stem}"
                if not any(k in inbound_refs for k in (rel, rel_no_ext, folder_stem, f.stem)):
                    parent_rel = _rel_posix(f.parent, root)
                    warnings.append(f"[Wiki 孤儿页] `{rel}` 未被 `{parent_rel}/INDEX.md` 或其他页面 [[双链]] 引用")

            prose_body = inline_code_re.sub("", fenced_code_re.sub("", body))
            for kw in diary_patterns:
                if kw in prose_body:
                    warnings.append(f"[记账腔] `{rel}` 出现「{kw}」，请改为第一人称或客观陈述")
                    break

            for pat, _ in tree_seed.SECRET_PATTERNS:
                if pat.search(text):
                    errors.append(f"[敏感密钥] `{rel}` 疑似包含明文密钥/Token，请立即脱敏")
                    break

    for stem, paths in sorted(stem_locations.items()):
        if len(paths) > 1 and stem.upper() != "INDEX":
            warnings.append(f"[同名冲突] `{stem}.md` 在多处重复出现（{', '.join(paths)}），易导致标签页与 [[双链]] 歧义")

    legacy_seed_dir = root / "seed"
    if legacy_seed_dir.is_dir():
        legacy_pages = [p for p in legacy_seed_dir.rglob("*.md") if p.is_file() and p.name.lower() != "readme.md"]
        if legacy_pages:
            warnings.append(f"[待归并旧目录] 检测到遗留 `seed/` 目录（共 {len(legacy_pages)} 篇），可按主题归并至 `01~04` 并标注 `--origin external`")

    return errors, warnings


def cmd_lint(root: Path, _args: argparse.Namespace) -> None:
    """Audit knowledge tree health: empty dirs, fragment names, diary tone, secrets, duplicate filenames."""
    reconciled = auto_reconcile_external_file_edits(root)
    if reconciled:
        print(f"🔄 已自动收拢并 Git 提交 {len(reconciled)} 处未提交的专页改动: {', '.join(reconciled)}\n")
    log_audit(root, "lint", "/")
    errors, warnings = _collect_tree_lint(root)

    print("🩺 Tree 健康度体检报告：")
    if not errors and not warnings:
        print("  ✅ 0 error / 0 warning — 知识树结构健康。")
        return
    for e in errors:
        print(f"  ❌ {e}")
    for w in warnings:
        print(f"  ⚠️ {w}")
    print(f"\n总计：{len(errors)} error(s), {len(warnings)} warning(s)")
    if errors:
        sys.exit(1)


def cmd_diff(root: Path, args: argparse.Namespace) -> None:
    """Show Git diff for a specific commit/range or the latest cognitive change."""
    if not (root / ".git").exists():
        print("❌ 当前目录尚未初始化 Git 仓库", file=sys.stderr)
        sys.exit(1)
    ref = getattr(args, "ref", "") or ""
    log_audit(root, "diff", ref or "HEAD")
    if ref:
        res = git_run(root, ["show", "--stat", "-p", ref])
        if res.returncode != 0:
            print(res.stderr.strip() or "❌ git diff 执行失败", file=sys.stderr)
            sys.exit(res.returncode)
        print(res.stdout or "(无变更差异)")
        return

    status = git_run(root, ["status", "--porcelain", "-uall"]).stdout.strip()
    if status:
        parts: list[str] = []
        head_ok = git_run(root, ["rev-parse", "--verify", "HEAD"]).returncode == 0
        diff_res = git_run(root, ["diff", "HEAD"]) if head_ok else git_run(root, ["diff"])
        if diff_res.stdout.strip():
            parts.append(diff_res.stdout.rstrip())
        untracked = [ln[3:].strip() for ln in status.splitlines() if ln.startswith("?? ")]
        if untracked:
            parts.append("未追踪文件 (Untracked):\n" + "\n".join(f"  + {u}" for u in untracked))
        print("\n\n".join(parts) if parts else "(无变更差异)")
        return

    res = git_run(root, ["show", "--stat", "-p", "HEAD"])
    if res.returncode != 0:
        print(res.stderr.strip() or "❌ 尚无 Git 提交历史", file=sys.stderr)
        sys.exit(res.returncode)
    print(res.stdout or "(无变更差异)")


def _safe_revert_commit(root: Path, commit: str, agent: str) -> tuple[bool, str]:
    """
    Safely revert a Git commit (even non-HEAD commits) without choking on `.tree/changelog.jsonl` append conflicts.
    Refuses reverting the initial root commit and preserves append-only changelog history.
    Always runs `git revert --abort` on failure so `.git/REVERT_HEAD` is never left dirty.
    """
    if not (root / ".git").exists():
        return False, "当前目录尚未初始化 Git 仓库"
    if (root / ".git" / "REVERT_HEAD").exists():
        git_run(root, ["revert", "--abort"])

    # Guard against reverting the root init commit (which would wipe README.md and .tree/config.json)
    par_res = git_run(root, ["rev-list", "--parents", "-n", "1", commit])
    if par_res.returncode != 0:
        return False, _format_git_err(par_res)
    par_tokens = (par_res.stdout or "").strip().split()
    if len(par_tokens) <= 1:
        return False, f"禁止回滚初始根提交 `{commit}`（回滚会清空 README.md 与 .tree/config.json 初始化骨架）"

    rev = git_run(root, ["revert", "--no-commit", commit])
    if rev.returncode != 0:
        unmerged_res = git_run(root, ["diff", "--name-only", "--diff-filter=U"])
        unmerged = [p.strip() for p in (unmerged_res.stdout or "").splitlines() if p.strip()]
        if unmerged and set(unmerged) == {".tree/changelog.jsonl"}:
            chk = git_run(root, ["checkout", "HEAD", "--", ".tree/changelog.jsonl"])
            if chk.returncode != 0:
                git_run(root, ["revert", "--abort"])
                return False, _format_git_err(chk)
        else:
            err_msg = _format_git_err(rev)
            if (root / ".git" / "REVERT_HEAD").exists():
                git_run(root, ["revert", "--abort"])
            return False, err_msg

    # Always restore HEAD's append-only `.tree/changelog.jsonl` before appending the revert entry
    if git_run(root, ["cat-file", "-e", "HEAD:.tree/changelog.jsonl"]).returncode == 0:
        git_run(root, ["checkout", "HEAD", "--", ".tree/changelog.jsonl"])

    # Record revert event into changelog cleanly on top of HEAD
    append_jsonl(
        ensure_meta_dir(root) / "changelog.jsonl",
        {
            "timestamp": now_iso(),
            "action": "revert",
            "path": commit,
            "agent": agent,
            "reason": f"安全回滚提交 {commit}",
        },
    )
    add_res = git_run(root, ["add", "-A", "--", ".tree/changelog.jsonl"])
    if add_res.returncode != 0:
        if (root / ".git" / "REVERT_HEAD").exists():
            git_run(root, ["revert", "--abort"])
        return False, _format_git_err(add_res)

    msg = f"tree(revert): {commit} — 安全回滚认知提交 [by {agent}]"
    c_res = git_run(root, ["commit", "-q", "-m", msg])
    if c_res.returncode != 0:
        err_msg = _format_git_err(c_res)
        if (root / ".git" / "REVERT_HEAD").exists():
            git_run(root, ["revert", "--abort"])
        return False, err_msg
    return True, ""


def cmd_revert(root: Path, args: argparse.Namespace) -> None:
    """Safely revert a specific Git commit in Tree history."""
    agent = _resolve_caller_agent(getattr(args, "agent", ""))
    # Allow direct human terminal reverts without AI gate, while preventing non-interactive AI from bypassing via `--yes`
    is_human_interactive = (agent == "cli-user") or (bool(getattr(args, "yes", False)) and sys.stdin.isatty())
    if not is_human_interactive:
        if getattr(args, "yes", False):
            print("💡 提示：非交互环境下 `--yes` 不可绕过 AI 维护门禁（人类请在交互终端执行）。", file=sys.stderr)
        verify_readme_gate(root, agent=agent)
    commit = args.commit.strip()
    ok, err = _safe_revert_commit(root, commit, agent=agent)
    if not ok:
        print(f"❌ 回滚 `{commit}` 失败：{err}", file=sys.stderr)
        sys.exit(1)
    log_audit(root, "revert", commit, agent=agent)
    print(f"⏪ 已安全回滚提交 `{commit}` 并生成新版本记录。")
    auto_refresh_global_instructions_if_mounted(root)


def cmd_log(root: Path, args: argparse.Namespace) -> None:
    res = git_run(root, ["log", f"-n{args.limit}", "--pretty=format:%h  %ad  %s", "--date=short"])
    if res.stdout:
        print("📜 Tree 认知演进历史 (Git Commits):")
        print(res.stdout)
    elif res.returncode != 0:
        err = (res.stderr or "").strip()
        if "does not have any commits yet" in err:
            print("ℹ️ 尚无 Git 提交记录（可能因初始化时未配置 Git 身份，配置后写入首篇页面即可生成历史）。")
        else:
            print(f"⚠️ 无法读取 Git 历史: {_format_git_err(res)}", file=sys.stderr)
    else:
        print("ℹ️ 尚无 Git 提交记录。")
    audit_path = root / ".tree" / "audit.jsonl"
    if args.audit and audit_path.exists():
        print("\n🛡️ 最近 Agent 访问与读写审计 (.tree/audit.jsonl):")
        lines = audit_path.read_text(encoding="utf-8", errors="ignore").splitlines()[-args.limit :]
        for line in lines:
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
                print(
                    f"  [{rec.get('timestamp', '-')}] {rec.get('agent', '-')} -> "
                    f"{rec.get('action', '-')} ({rec.get('target', '-')}) {rec.get('detail', '')}"
                )
            except Exception:
                continue


def _sync_gitignore_entries(root: Path, entries: tuple[str, ...]) -> None:
    gitignore = root / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text("\n".join(entries) + "\n", encoding="utf-8")
        return
    content = gitignore.read_text(encoding="utf-8")
    existing_lines = {ln.strip() for ln in content.splitlines()}
    missing = [entry for entry in entries if entry not in existing_lines]
    if missing:
        sep = "" if content.endswith("\n") or not content else "\n"
        gitignore.write_text(content + sep + "\n".join(missing) + "\n", encoding="utf-8")


def _ensure_sync_gitignore(root: Path) -> None:
    entries: list[str] = [
        ".DS_Store",
        ".tree/audit.jsonl",
        ".tree/sync.log",
        "outputs/",
    ]
    if (root / "bin").exists():
        entries.append("bin/__pycache__/")
    entries.extend([
        ".tree/staging/",
        ".tree/sources.json",
    ])
    _sync_gitignore_entries(root, tuple(entries))


def _launchd_label_and_plist(root: Path) -> tuple[str, Path]:
    vault_hash = hashlib.sha256(str(root.resolve()).encode("utf-8")).hexdigest()[:8]
    label = f"com.tree.autosync.{vault_hash}"
    legacy = Path.home() / "Library" / "LaunchAgents" / "com.tree.autosync.plist"
    scoped = Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
    if not scoped.exists() and legacy.exists():
        return "com.tree.autosync", legacy
    return label, scoped


def _sync_schedule_status(root: Path) -> tuple[bool, str]:
    if sys.platform == "darwin":
        _, plist_path = _launchd_label_and_plist(root)
        if not plist_path.exists():
            return False, "未配置每日定时同步（macOS launchd）"
        import plistlib
        try:
            data = plistlib.loads(plist_path.read_bytes())
            cal = data.get("StartCalendarInterval", {})
            hh = int(cal.get("Hour", 23))
            mm = int(cal.get("Minute", 0))
            return True, f"已开启每日 {hh:02d}:{mm:02d} 自动同步（launchd: {plist_path}）"
        except Exception:
            return True, f"已存在定时配置（{plist_path}）"
    if sys.platform.startswith("win"):
        return False, "Windows 暂不支持自动注册定时同步（请使用任务计划程序定时执行 `tree sync`）"
    try:
        res = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    except FileNotFoundError:
        return False, "未检测到 crontab，未配置每日定时同步"
    if res.returncode == 0:
        marker = f"# tree-autosync:{root}"
        for line in res.stdout.splitlines():
            if marker in line:
                return True, f"已开启每日定时同步（crontab: {line}）"
    return False, "未配置每日定时同步（crontab）"


def cmd_remote(root: Path, args: argparse.Namespace) -> None:
    if not (root / ".git").exists():
        git_run(root, ["init", "-q"])
    name = args.name.strip() or "origin"

    if args.remove:
        res = git_run(root, ["remote", "remove", name])
        if res.returncode != 0:
            print(f"❌ 移除远端 `{name}` 失败: {res.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
        print(f"✅ 已移除远端仓库 `{name}`")
        return

    if not args.url:
        res = git_run(root, ["remote", "-v"])
        remotes = (res.stdout or "").strip()
        if remotes:
            print("当前绑定的远端仓库：")
            print(remotes)
        else:
            print("ℹ️ 当前为纯本地模式，尚未绑定 GitHub / GitLab 远端仓库。")
            print("👉 绑定示例: tree remote git@github.com:<你的用户名>/my-tree.git")
        _, sched_msg = _sync_schedule_status(root)
        print(f"定时同步状态: {sched_msg}")
        return

    url = args.url.strip()
    existing = git_run(root, ["remote", "get-url", name])
    if existing.returncode == 0:
        res = git_run(root, ["remote", "set-url", name, url])
        action_label = "更新"
    else:
        res = git_run(root, ["remote", "add", name, url])
        action_label = "绑定"
    if res.returncode != 0:
        print(f"❌ {action_label}远端 `{name}` 失败: {res.stderr.strip()}", file=sys.stderr)
        sys.exit(1)

    _ensure_sync_gitignore(root)
    log_audit(root, "remote", name, detail=url)
    print(f"✅ 已{action_label}远端仓库 `{name}` -> {url}")
    print("⚠️ 安全提醒：请务必确认该 GitHub / GitLab 仓库为 Private（私有），避免个人上下文泄露至公网。")
    print("👉 立即同步: tree sync")
    print("👉 开启每日定时同步: tree sync schedule --enable --time 23:00")


def cmd_sync(root: Path, args: argparse.Namespace) -> None:
    if not (root / ".git").exists():
        print("ℹ️ 当前目录尚未初始化 Git 仓库，跳过远程同步。")
        return

    remote = args.remote.strip() or "origin"
    remote_check = git_run(root, ["remote", "get-url", remote])
    if remote_check.returncode != 0:
        print(f"ℹ️ 当前为纯本地模式，未配置远端 `{remote}`（可用 `tree remote <私有仓库URL>` 绑定）。")
        return

    _ensure_sync_gitignore(root)

    status_res = git_run(root, ["status", "--porcelain", "-uall"])
    dirty_lines = [ln for ln in (status_res.stdout or "").splitlines() if ln.strip()]
    if dirty_lines:
        sensitive_name_re = re.compile(r"(?:^|/)(?:\.env(?:\..+)?|.*\.(?:pem|key|p12|pfx|kdbx))$", re.IGNORECASE)
        allowed_sync_prefixes = tuple(f"{b}/" for b in [*get_branches(root), "seed"])
        allowed_sync_exact = {"README.md", "readme.md", ".gitignore", ".tree/config.json", ".tree/changelog.jsonl"}
        sync_stage_paths: list[str] = []
        blocked_sensitive: list[str] = []
        skipped_extra: list[str] = []

        for ln in dirty_lines:
            rel_p = ln[3:].strip().strip('"')
            if " -> " in rel_p:
                rel_p = rel_p.split(" -> ", 1)[1].strip().strip('"')
            if sensitive_name_re.search(rel_p):
                blocked_sensitive.append(f"{rel_p}（敏感凭证文件名）")
                continue
            in_scope = rel_p in allowed_sync_exact or any(rel_p.startswith(pfx) for pfx in allowed_sync_prefixes)
            if not in_scope:
                skipped_extra.append(rel_p)
                continue
            fp = root / rel_p
            if fp.is_file():
                try:
                    txt = fp.read_text(encoding="utf-8", errors="ignore")
                    if any(pat.search(txt) for pat, _ in tree_seed.SECRET_PATTERNS):
                        blocked_sensitive.append(f"{rel_p}（疑似含明文密钥/Token）")
                        continue
                except Exception:
                    pass
            sync_stage_paths.append(rel_p)

        if blocked_sensitive:
            print("❌ 同步安全拦截：检测到敏感凭证或明文密钥文件，已中止提交与推送：", file=sys.stderr)
            for item in blocked_sensitive:
                print(f"  - {item}", file=sys.stderr)
            print("👉 请先移除或脱敏敏感文件（或加入 .gitignore）后再执行 `tree sync`。", file=sys.stderr)
            sys.exit(1)

        if skipped_extra:
            print(f"ℹ️ 跳过知识树范围外的本地文件（不自动提交推送）: {', '.join(skipped_extra[:5])}")

        if sync_stage_paths:
            if args.dry_run:
                print(f"[dry-run] 检测到 {len(sync_stage_paths)} 处本地内容改动，将自动提交并同步")
            else:
                add_res = git_run(root, ["add", "-A", "--", *sync_stage_paths])
                if add_res.returncode != 0:
                    print(f"❌ 自动暂存本地变更失败: {_format_git_err(add_res)}", file=sys.stderr)
                    sys.exit(1)
                commit_res = git_run(root, ["commit", "-q", "--only", "-m", "tree(sync): 自动提交本地变更", "--", *sync_stage_paths])
                if commit_res.returncode != 0:
                    print(f"❌ 自动提交本地变更失败: {_format_git_err(commit_res)}", file=sys.stderr)
                    sys.exit(1)

    branch = args.branch.strip()
    if not branch:
        br_res = git_run(root, ["rev-parse", "--abbrev-ref", "HEAD"])
        branch = (br_res.stdout or "").strip()
        if not branch or branch == "HEAD":
            branch = "main"

    if args.dry_run:
        print(f"[dry-run] 将同步分支 `{branch}` 至远端 `{remote}` ({remote_check.stdout.strip()})")
        return

    ls_res = git_run(root, ["ls-remote", "--heads", remote, branch])
    if ls_res.returncode == 0 and (ls_res.stdout or "").strip():
        pull_res = git_run(root, ["pull", "--rebase", remote, branch])
        if pull_res.returncode != 0:
            git_run(root, ["rebase", "--abort"])
            print(
                f"❌ 远程同步冲突（已自动中止 rebase，本地数据未受损）:\n{pull_res.stderr.strip()}",
                file=sys.stderr,
            )
            sys.exit(1)

    push_res = git_run(root, ["push", "-u", remote, branch])
    if push_res.returncode != 0:
        print(f"❌ 推送至 `{remote}/{branch}` 失败:\n{push_res.stderr.strip()}", file=sys.stderr)
        sys.exit(1)

    log_audit(root, "sync", remote, detail=branch)
    print(f"✅ [{now_iso()}] 已完成远程同步 -> {remote}/{branch}")


def cmd_sync_schedule(root: Path, args: argparse.Namespace) -> None:
    if sys.platform.startswith("win"):
        print("ℹ️ Windows 暂不支持自动注册定时同步，请使用 Windows 任务计划程序定时运行 `tree sync`。")
        return
    if args.disable:
        if sys.platform == "darwin":
            _, plist_path = _launchd_label_and_plist(root)
            uid = os.getuid()
            subprocess.run(["launchctl", "bootout", f"gui/{uid}", str(plist_path)], capture_output=True)
            subprocess.run(["launchctl", "unload", "-w", str(plist_path)], capture_output=True)
            if plist_path.exists():
                plist_path.unlink()
            print("✅ 已关闭每日定时自动同步（macOS launchd）")
            return
        res = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
        if res.returncode == 0:
            marker = f"# tree-autosync:{root}"
            kept = [line for line in res.stdout.splitlines() if marker not in line]
            new_cron = "\n".join(kept) + ("\n" if kept else "")
            subprocess.run(["crontab", "-"], input=new_cron, text=True, check=False)
        print("✅ 已关闭每日定时自动同步（crontab）")
        return

    if args.enable:
        m = re.match(r"^(\d{1,2}):(\d{2})$", args.time.strip())
        if not m:
            print("❌ 时间格式无效，请使用 HH:MM（例如 23:00）", file=sys.stderr)
            sys.exit(1)
        hour, minute = int(m.group(1)), int(m.group(2))
        if not (0 <= hour <= 23 and 0 <= minute <= 59):
            print("❌ 时间超出范围（小时 0-23，分钟 0-59）", file=sys.stderr)
            sys.exit(1)

        _ensure_sync_gitignore(root)
        ensure_meta_dir(root)
        script_path = Path(__file__).resolve()

        if sys.platform == "darwin":
            import plistlib
            label, plist_path = _launchd_label_and_plist(root)
            plist_path.parent.mkdir(parents=True, exist_ok=True)
            log_path = root / ".tree" / "sync.log"
            plist_data = {
                "Label": label,
                "ProgramArguments": [sys.executable, str(script_path), "sync"],
                "WorkingDirectory": str(root),
                "EnvironmentVariables": {
                    "TREE_HOME": str(root),
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
                },
                "StartCalendarInterval": {"Hour": hour, "Minute": minute},
                "StandardOutPath": str(log_path),
                "StandardErrorPath": str(log_path),
            }
            plist_path.write_bytes(plistlib.dumps(plist_data))
            uid = os.getuid()
            subprocess.run(["launchctl", "bootout", f"gui/{uid}", str(plist_path)], capture_output=True)
            boot_res = subprocess.run(
                ["launchctl", "bootstrap", f"gui/{uid}", str(plist_path)],
                capture_output=True,
                text=True,
            )
            if boot_res.returncode != 0:
                load_res = subprocess.run(["launchctl", "load", "-w", str(plist_path)], capture_output=True, text=True)
                if load_res.returncode != 0:
                    err_txt = (load_res.stderr or boot_res.stderr or "").strip()
                    print(f"❌ 注册 macOS launchd 定时任务失败: {err_txt}", file=sys.stderr)
                    sys.exit(1)
            print(f"✅ 已开启每日 {hour:02d}:{minute:02d} 自动远程同步（macOS launchd）")
            print(f"   配置文件: {plist_path}")
            print(f"   同步日志: {log_path}")
        else:
            log_path = root / ".tree" / "sync.log"
            marker = f"# tree-autosync:{root}"
            cron_line = f"{minute} {hour} * * * TREE_HOME=\"{root}\" \"{sys.executable}\" \"{script_path}\" sync >> \"{log_path}\" 2>&1 {marker}"
            try:
                res = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
            except FileNotFoundError:
                print("❌ 未检测到 crontab 命令，无法注册定时同步", file=sys.stderr)
                sys.exit(1)
            existing_lines = res.stdout.splitlines() if res.returncode == 0 else []
            kept = [line for line in existing_lines if marker not in line]
            kept.append(cron_line)
            new_cron = "\n".join(kept) + "\n"
            proc = subprocess.run(["crontab", "-"], input=new_cron, capture_output=True, text=True)
            if proc.returncode != 0:
                print(f"❌ 写入 crontab 失败: {proc.stderr.strip()}", file=sys.stderr)
                sys.exit(1)
            print(f"✅ 已开启每日 {hour:02d}:{minute:02d} 自动远程同步（crontab）")

        remote_check = git_run(root, ["remote", "get-url", "origin"])
        if remote_check.returncode != 0:
            print("⚠️ 提示：当前尚未绑定 `origin` 远端仓库，请再执行 `tree remote <私有仓库URL>` 完成绑定。")
        return

    _, msg = _sync_schedule_status(root)
    print(msg)


def _save_tree_config(root: Path, cfg: dict) -> None:
    config_file = root / ".tree" / "config.json"
    atomic_write_text(config_file, json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")


def _validate_branch_name(name: str) -> str:
    clean = name.strip().strip("/")
    if not clean or "/" in clean or "\\" in clean or clean in {".", ".."} or clean.startswith(".") or clean in RESERVED_TOP_DIRS:
        raise ValueError(f"非法的一级主干名称: `{name}`")
    return clean


def cmd_branch(root: Path, args: argparse.Namespace) -> None:
    """Manage top-level content branches (`list`, `add`, `rename`, `remove`) for full schema evolution."""
    subcmd = getattr(args, "branch_cmd", "") or "list"
    branches = get_branches(root)
    roles = get_branch_roles(root, branches)

    if subcmd == "list":
        print("🌳 当前启用的知识树一级主干：\n")
        for b in branches:
            b_dir = root / b
            cnt = len(_iter_branch_pages(root, b_dir)) if b_dir.is_dir() else 0
            r_tags = [r for r in ("identity", "thinking", "active", "norms") if b in roles.get(r, set())]
            role_str = f" · 角色: {', '.join(r_tags)}" if r_tags else ""
            exists_str = "" if b_dir.is_dir() else " [目录未建]"
            print(f"  - {b}/ ({cnt} 篇{role_str}){exists_str}")
        return

    agent = _resolve_caller_agent(getattr(args, "agent", ""))
    verify_readme_gate(root, agent=agent)
    cfg = load_tree_config(root)
    cfg_branches = [str(x).strip() for x in (cfg.get("branches") or list(branches)) if isinstance(x, str) and str(x).strip()]
    for b in branches:
        if b not in cfg_branches:
            cfg_branches.append(b)
    raw_roles = cfg.get("branch_roles")
    cfg_roles: dict[str, list[str]] = (
        {k: [str(v).strip() for v in vals if isinstance(v, str) and str(v).strip()] for k, vals in raw_roles.items() if isinstance(vals, list)}
        if isinstance(raw_roles, dict)
        else {}
    )

    if subcmd == "add":
        try:
            new_b = _validate_branch_name(args.name)
        except ValueError as exc:
            print(f"❌ {exc}", file=sys.stderr)
            sys.exit(1)
        role = (getattr(args, "role", "") or "").strip()
        already_exists = (root / new_b).is_dir() and new_b in cfg_branches and (not role or new_b in cfg_roles.get(role, []))
        if already_exists:
            print(f"ℹ️ 一级主干 `{new_b}/` 已存在，无需重复添加。")
            return
        (root / new_b).mkdir(parents=True, exist_ok=True)
        if new_b not in cfg_branches:
            cfg_branches.append(new_b)
        cfg["branches"] = cfg_branches
        if role:
            lst = cfg_roles.setdefault(role, [])
            if new_b not in lst:
                lst.append(new_b)
            cfg["branch_roles"] = cfg_roles
        _save_tree_config(root, cfg)
        reason = getattr(args, "reason", "") or f"新增一级主干 {new_b}"
        append_jsonl(
            ensure_meta_dir(root) / "changelog.jsonl",
            {"timestamp": now_iso(), "action": "branch:add", "path": new_b, "agent": agent, "reason": reason},
        )
        log_audit(root, "branch:add", new_b, agent=agent, detail=reason)
        git_ok, git_err = git_commit_change(root, [".tree/config.json"], "branch:add", reason, agent)
        if git_ok:
            print(f"✅ 已新增一级主干 `{new_b}/` 并登记到 `.tree/config.json`")
        else:
            print(f"✅ 已新增一级主干 `{new_b}/`（⚠️ Git 提交失败: {git_err}）", file=sys.stderr)
        return

    if subcmd == "rename":
        try:
            old_b = _validate_branch_name(args.old_name)
            new_b = _validate_branch_name(args.new_name)
        except ValueError as exc:
            print(f"❌ {exc}", file=sys.stderr)
            sys.exit(1)
        if old_b == new_b:
            print("❌ 新旧主干名称相同", file=sys.stderr)
            sys.exit(1)
        old_dir = root / old_b
        new_dir = root / new_b
        if not old_dir.is_dir():
            print(f"❌ 原主干目录不存在: `{old_b}`", file=sys.stderr)
            sys.exit(1)
        if new_dir.exists():
            print(f"❌ 目标主干已存在: `{new_b}`", file=sys.stderr)
            sys.exit(1)

        had_tracked_old = bool((git_run(root, ["ls-files", old_b]).stdout or "").strip())

        # Preserve inferred semantic roles before renaming so `03-`/`04-` renamed to custom names keep their behavior
        for r_key in ("identity", "thinking", "active", "norms"):
            if old_b in roles.get(r_key, set()):
                lst = cfg_roles.setdefault(r_key, list(roles[r_key]))
                cfg_roles[r_key] = [new_b if x == old_b else x for x in lst]

        old_dir.rename(new_dir)
        cfg["branches"] = [new_b if x == old_b else x for x in cfg_branches]
        if new_b not in cfg["branches"]:
            cfg["branches"].append(new_b)
        if isinstance(cfg.get("identity_branches"), list):
            cfg["identity_branches"] = [new_b if x == old_b else x for x in cfg["identity_branches"]]
        if isinstance(cfg.get("l0_excluded_branches"), list):
            cfg["l0_excluded_branches"] = [new_b if x == old_b else x for x in cfg["l0_excluded_branches"]]
        if cfg_roles:
            cfg["branch_roles"] = {k: list(dict.fromkeys(v)) for k, v in cfg_roles.items() if v}
        _save_tree_config(root, cfg)

        # Update explicit `[[old_b/...]]` wikilinks outside code blocks across all branches + legacy seed/
        link_updates: list[str] = []
        prefix_old = f"[[{old_b}/"
        prefix_new = f"[[{new_b}/"
        scan_branches = [*cfg["branches"], "seed"] if (root / "seed").is_dir() else list(cfg["branches"])
        for b in scan_branches:
            b_dir = root / b
            if not b_dir.is_dir():
                continue
            for md_f in _iter_branch_pages(root, b_dir):
                raw_t = md_f.read_text(encoding="utf-8", errors="ignore")
                if prefix_old not in raw_t:
                    continue
                new_t = _replace_outside_code(raw_t, lambda chunk: chunk.replace(prefix_old, prefix_new))
                if new_t != raw_t:
                    atomic_write_text(md_f, new_t)
                    link_updates.append(_rel_posix(md_f, root))

        reason = getattr(args, "reason", "") or f"重命名一级主干 {old_b} -> {new_b}"
        append_jsonl(
            ensure_meta_dir(root) / "changelog.jsonl",
            {"timestamp": now_iso(), "action": "branch:rename", "path": f"{old_b} -> {new_b}", "agent": agent, "reason": reason},
        )
        log_audit(root, "branch:rename", f"{old_b} -> {new_b}", agent=agent, detail=reason)
        commit_paths: list[str] = [".tree/config.json", *link_updates]
        if had_tracked_old:
            commit_paths.insert(0, old_b)
        if any(new_dir.rglob("*")):
            commit_paths.insert(0, new_b)
        git_ok, git_err = git_commit_change(root, commit_paths, "branch:rename", reason, agent)
        auto_refresh_global_instructions_if_mounted(root)
        link_msg = f"，同步更新 {len(link_updates)} 处双链引用" if link_updates else ""
        if git_ok:
            print(f"✅ 已重命名主干 `{old_b}/` → `{new_b}/`（已保留原角色语义{link_msg}）并完成 Git 提交")
        else:
            print(f"✅ 已重命名主干 `{old_b}/` → `{new_b}/`（⚠️ Git 提交失败: {git_err}）", file=sys.stderr)
        return

    if subcmd == "remove":
        try:
            rem_b = _validate_branch_name(args.name)
        except ValueError as exc:
            print(f"❌ {exc}", file=sys.stderr)
            sys.exit(1)
        rem_dir = root / rem_b
        in_cfg = rem_b in cfg_branches
        if not rem_dir.is_dir() and not in_cfg:
            print(f"❌ 主干不存在: `{rem_b}`", file=sys.stderr)
            sys.exit(1)
        had_tracked_rem = bool((git_run(root, ["ls-files", rem_b]).stdout or "").strip())
        force = bool(getattr(args, "force", False))
        if rem_dir.is_dir():
            pages = _iter_branch_pages(root, rem_dir, include_readme=True)
            all_entries = [p for p in rem_dir.rglob("*") if p.is_file() and p.name != ".DS_Store"]
            if (pages or all_entries) and not force:
                print(
                    f"❌ 主干 `{rem_b}/` 非空（含 {len(pages)} 篇页面、共 {len(all_entries)} 个文件），请先迁移或清理，或确认后加 `--force` 强制删除。",
                    file=sys.stderr,
                )
                sys.exit(1)
            shutil.rmtree(rem_dir)
        cfg["branches"] = [x for x in cfg_branches if x != rem_b]
        if isinstance(cfg.get("identity_branches"), list):
            cfg["identity_branches"] = [x for x in cfg["identity_branches"] if x != rem_b]
        if isinstance(cfg.get("l0_excluded_branches"), list):
            cfg["l0_excluded_branches"] = [x for x in cfg["l0_excluded_branches"] if x != rem_b]
        if cfg_roles:
            cfg["branch_roles"] = {k: [x for x in v if x != rem_b] for k, v in cfg_roles.items()}
        _save_tree_config(root, cfg)
        reason = getattr(args, "reason", "") or f"移除一级主干 {rem_b}"
        append_jsonl(
            ensure_meta_dir(root) / "changelog.jsonl",
            {"timestamp": now_iso(), "action": "branch:remove", "path": rem_b, "agent": agent, "reason": reason},
        )
        log_audit(root, "branch:remove", rem_b, agent=agent, detail=reason)
        commit_paths = [rem_b, ".tree/config.json"] if had_tracked_rem else [".tree/config.json"]
        git_ok, git_err = git_commit_change(root, commit_paths, "branch:remove", reason, agent)
        auto_refresh_global_instructions_if_mounted(root)
        if git_ok:
            print(f"✅ 已移除一级主干 `{rem_b}/` 并清理 `.tree/config.json`")
        else:
            print(f"✅ 已移除一级主干 `{rem_b}/`（⚠️ Git 提交失败: {git_err}）", file=sys.stderr)
        return


def main() -> None:
    parser = argparse.ArgumentParser(description="Tree — 个人上下文操作系统 CLI")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("init", help="初始化 Tree 四维默认骨架、根契约 README.md 与 Git 仓库")
    p_inst = sub.add_parser("install-skill", help="一键挂载 tree CLI、Skill 与全局指令受控块到本机已存在的 Agent 目录（最小足迹原则）")
    p_inst.add_argument("--bin-dir", default="", help="CLI 软链目录（默认 ~/.local/bin）")
    p_inst.add_argument("--target", default="", help="额外指定的 skills 目录路径")
    p_inst.add_argument("--dry-run", action="store_true", help="仅预览将挂载哪些目录，不实际写入")
    p_inst.add_argument("--force", action="store_true", help="强制覆盖已存在的非软链目标")
    p_inst.add_argument("--no-global-rules", action="store_true", help="仅挂载 Skill 软链，不同步全局指令文件（CLAUDE.md / AGENTS.md / GEMINI.md）受控块")

    p_sglob = sub.add_parser("sync-global", help="同步或移除各宿主全局指令文件（CLAUDE.md / AGENTS.md / GEMINI.md 等）中的 L0 常驻受控块")
    p_sglob.add_argument("--dry-run", action="store_true", help="仅预览将同步哪些全局指令文件，不实际写入")
    p_sglob.add_argument("--remove", action="store_true", help="从所有全局指令文件中干净移除 Tree 受控块（保留用户原有内容）")
    p_ctx = sub.add_parser("context", help="生成供 AI Agent 注入的 L0 全景个人上下文包（支持情境自动对焦与话题透镜）")
    p_ctx.add_argument("--cwd", default="", help="指定当前工作目录以触发空间与场景自动对焦（默认取调用时的当前目录）")
    p_ctx.add_argument("-q", "--query", default="", help="可选：传入当前任务或话题关键词，跨 01~04 自动对焦并内联最相关专页")
    p_ctx.add_argument("--no-auto-focus", action="store_true", help="关闭基于当前工作目录与场景的情境自动对焦")
    p_ctx.add_argument("--no-always", action="store_true", help="跳过重复输出常驻（always: true）正文（适用于宿主全局指令已注入常驻底线的场景）")

    p_seed = sub.add_parser("seed", help="纯本地冷启动采集层：只读探测/提取本机 11 款 AI 记忆、历史对话、Chrome 与本地导出包")
    seed_sub = p_seed.add_subparsers(dest="seed_cmd")
    seed_sub.add_parser("scan", help="只读扫描本机内置的 11 款 AI 客户端记忆/聊天与 Chrome")
    p_seed_ext = seed_sub.add_parser("extract", help="经授权后生成记忆全量索引，并清洗、脱敏对话/数据库线索至 .tree/staging/")
    p_seed_ext.add_argument("--sources", default="", help="逗号分隔内置本机来源: claude,codex,antigravity,cursor,trae,workbuddy,douchat,hermes,openclaw,eden,deepseek,chrome（默认全部已就绪来源）")
    p_seed_ext.add_argument("--days", type=int, default=60, help="仅提取最近 N 天的记录（默认 60 天，0 表示不限）")
    p_seed_ext.add_argument("--max-sessions", type=int, default=30, help="每个来源最多提取的活跃会话或条目数（默认 30）")
    p_seed_ext.add_argument("--memories-only", action="store_true", help="仅生成旧记忆与规则全量索引（及数据库记忆解包），不提取对话")
    p_seed_ext.add_argument("--chats-only", action="store_true", help="仅提取对话与外部线索，不生成旧记忆索引")
    p_seed_ext.add_argument("--full", action="store_true", help="忽略历史增量游标，全量重新提取时间窗口内所有会话")
    p_seed_read = seed_sub.add_parser("read", help="只读查看单份本地记忆/规则文件（自动脱敏并剥离 Tree 自身同步块）")
    p_seed_read.add_argument("path", help="目标记忆文件路径（来自 memories-index.md 或第三方记忆系统路径）")
    p_seed_read.add_argument("--max-chars", type=int, default=12000, help="最多输出字符数（默认 12000，0 表示全文）")
    p_seed_imp = seed_sub.add_parser("import", help="导入 ChatGPT/Claude Web/豆包/WorkBuddy 导出包或本地笔记目录")
    p_seed_imp.add_argument("path", help="导出文件（.zip/.json/.jsonl/.md/.txt）或目录路径")
    p_seed_imp.add_argument("--label", default="", help="来源标签名（如 chatgpt / doubao / workbuddy）")
    seed_sub.add_parser("status", help="查看本机采集源游标与 .tree/staging/ 待蒸馏素材状态")
    seed_sub.add_parser("clear", help="蒸馏确认入树后清空 .tree/staging/ 临时素材")

    p_chat = sub.add_parser("chat", help="跨 AI 实时接力：按需检索并拉取用户在其他 AI 客户端的详细聊天记录")
    chat_sub = p_chat.add_subparsers(dest="chat_cmd")
    p_chat_ls = chat_sub.add_parser("list", help="列出本机各 AI 客户端（Claude/Codex/Antigravity/Cursor/Trae/WorkBuddy/豆包/Hermes/Eden/DeepSeek）的近期会话")
    p_chat_ls.add_argument("--source", default="", help="筛选来源（逗号分隔，如 cursor,claude,workbuddy）")
    p_chat_ls.add_argument("--query", default="", help="按关键词筛选标题或首轮内容")
    p_chat_ls.add_argument("-n", "--limit", type=int, default=15, help="最多显示条数（默认 15）")
    p_chat_rd = chat_sub.add_parser("read", help="拉取指定跨 AI 会话的详细双边问答上下文（自动去噪脱敏）")
    p_chat_rd.add_argument("ref", help="会话标识 `<source>:<id前缀>`（由 tree chat list 获取）")
    p_chat_rd.add_argument("--turns", type=int, default=24, help="最多输出最近 N 轮消息（默认 24，0 表示全部）")
    p_chat_rd.add_argument("--raw-code", action="store_true", help="保留完整大段代码块不折叠")

    p_list = sub.add_parser("list", help="浏览知识树目录结构")
    p_list.add_argument("subpath", nargs="?", default="", help="可选子目录路径")

    p_read = sub.add_parser("read", help="读取指定上下文页面")
    p_read.add_argument("path", help="页面相对路径")
    p_read.add_argument("--agent", default="", help="调用方 Agent 标识")

    p_rules = sub.add_parser("rules", help="读取根目录 README.md 维护宪法并打卡写前门禁（写入前必读）")
    p_rules.add_argument("--agent", default="", help="调用方 Agent 标识")
    p_rules.add_argument("--full", action="store_true", help="同时保留空的个性化定制占位区，输出完整 README.md 原文")

    p_write = sub.add_parser("write", help="创建或更新上下文页面并自动 Git Commit")
    p_write.add_argument("path", help="页面相对路径")
    p_write.add_argument("content", nargs="?", default="", help="Markdown 正文内容")
    p_write.add_argument("--stdin", action="store_true", help="从标准输入读取正文")
    p_write.add_argument("--reason", default="", help="本次认知更新原因")
    p_write.add_argument("--agent", default="", help="调用方 Agent 标识")
    p_write.add_argument("--status", choices=["active", "paused", "archived", "superseded"], default="", help="页面生命周期状态")
    p_write.add_argument("--kind", choices=["idea", "project"], default="", help="03 专页类型：idea（轻想法）或 project（长期投入项目/副业/自媒体）")
    p_write.add_argument("--location", default="", help="项目或资产关联的外部路径/仓库/链接（支持逗号分隔多路径，处于该目录时自动对焦）")
    p_write.add_argument("--when", default="", help="01~04 通用情境触发条件（如特征文件 `*.py, pyproject.toml`、场景词或触发关键词）")
    p_write.add_argument("--origin", choices=["self", "external", "mixed"], default="", help="内容来源级别：self（用户本人，默认）| external（外部参考）| mixed（本人判断+外部参考）")
    p_write.add_argument("--source", default="", help="来源出处（如外部 URL、书课名称或沉淀 Agent 标识）")
    always_grp = p_write.add_mutually_exclusive_group()
    always_grp.add_argument("--always", action="store_true", help="标记为常驻 L0（always: true），每次冷启动自动加载正文")
    always_grp.add_argument("--no-always", action="store_true", help="标记为按需加载（always: false），仅在 L0 目录露出一行索引")
    p_write.add_argument("--append", action="store_true", help="在已有页面正文末尾安全追加内容，避免全量覆写长文时丢失旧内容")
    p_write.add_argument("--force", action="store_true", help="跳过防截断缩水检查（原文>=200字符且新内容缩水超50%%时触发），强制整页覆写")

    p_del = sub.add_parser("delete", help="删除过期或已合并的页面")
    p_del.add_argument("path", help="页面相对路径")
    p_del.add_argument("--reason", default="", help="删除原因")
    p_del.add_argument("--agent", default="", help="调用方 Agent 标识")

    p_mv = sub.add_parser("move", help="重命名或跨目录移动页面（自动保留 Git 重命名历史并同步 [[双链]]）")
    p_mv.add_argument("src", help="原页面相对路径")
    p_mv.add_argument("dst", help="新页面相对路径")
    p_mv.add_argument("--reason", default="", help="移动或重命名原因")
    p_mv.add_argument("--agent", default="", help="调用方 Agent 标识")
    p_mv.add_argument("--force", action="store_true", help="若目标路径已存在则覆盖")

    p_branch = sub.add_parser("branch", help="管理知识树一级主干（支持查看、新增、安全重命名与清理，保留角色语义）")
    branch_sub = p_branch.add_subparsers(dest="branch_cmd")
    branch_sub.add_parser("list", help="列出当前启用的一级主干与角色绑定")
    p_br_add = branch_sub.add_parser("add", help="新增一级主干目录并登记到 .tree/config.json")
    p_br_add.add_argument("name", help="新主干目录名（如 05-客户档案 / 健康与运动）")
    p_br_add.add_argument("--role", choices=["identity", "thinking", "active", "norms"], default="", help="可选：绑定语义角色")
    p_br_add.add_argument("--reason", default="", help="变更原因")
    p_br_add.add_argument("--agent", default="", help="调用方 Agent 标识")
    p_br_ren = branch_sub.add_parser("rename", help="安全重命名一级主干（自动保留原角色语义并更新显式双链）")
    p_br_ren.add_argument("old_name", help="原主干名")
    p_br_ren.add_argument("new_name", help="新主干名")
    p_br_ren.add_argument("--reason", default="", help="变更原因")
    p_br_ren.add_argument("--agent", default="", help="调用方 Agent 标识")
    p_br_rem = branch_sub.add_parser("remove", help="移除已清空的一级主干并清理配置（加 --force 强删非空目录）")
    p_br_rem.add_argument("name", help="主干名")
    p_br_rem.add_argument("--force", action="store_true", help="允许删除非空主干目录")
    p_br_rem.add_argument("--reason", default="", help="变更原因")
    p_br_rem.add_argument("--agent", default="", help="调用方 Agent 标识")

    p_recent = sub.add_parser("recent", help="按近期更新与读写热度自动筛选最近的所思、所想、所做")
    p_recent.add_argument("--days", type=int, default=None, help="筛选最近 N 天内更新或被读写的活跃页面（默认取 config l0_recent_days=14；0 表示全部未休眠页）")

    p_search = sub.add_parser("search", help="全文与结构化元数据组合搜索个人上下文")
    p_search.add_argument("query", nargs="?", default="", help="可选搜索关键词（可省略，仅按元数据筛选）")
    p_search.add_argument("--kind", default="", help="按 kind 元数据筛选（如 idea / project）")
    p_search.add_argument("--status", default="", help="按 status 筛选（active / paused / archived / superseded）")
    p_search.add_argument("--tag", default="", help="按标签筛选（匹配 frontmatter tags 或正文 #标签）")
    p_search.add_argument("--always", choices=["true", "false"], default="", help="按是否常驻 L0（always）筛选")
    p_search.add_argument("--origin", choices=["self", "external", "mixed"], default="", help="按来源层级筛选（self / external / mixed）")
    p_search.add_argument("--branch", default="", help="按一级主干前缀筛选（如 02 / 03）")

    sub.add_parser("lint", help="知识树健康度自检（断链、Wiki 孤儿页、路径过深、空目录、碎片命名、常驻超长、when 泛词、缺少出处、记账腔、敏感密钥、同名冲突等）")

    p_diff = sub.add_parser("diff", help="查看最近一次或指定提交的认知变更差异")
    p_diff.add_argument("ref", nargs="?", default="", help="可选 Git Commit 哈希或范围（默认查看工作区改动或最新一次提交）")

    p_revert = sub.add_parser("revert", help="安全回滚指定的一次认知变更提交")
    p_revert.add_argument("commit", help="要回滚的 Git Commit 哈希（可由 tree log 查看）")
    p_revert.add_argument("--agent", default="", help="调用方 Agent 标识")
    p_revert.add_argument("-y", "--yes", action="store_true", help="人类直接确认回滚（跳过 AI 门禁）")

    p_log = sub.add_parser("log", help="查看认知演进 Git 历史与 Agent 审计日志")
    p_log.add_argument("-n", "--limit", type=int, default=10, help="显示条数")
    p_log.add_argument("--audit", action="store_true", default=False, help="同时显示 Agent 访问与读写审计日志")

    p_remote = sub.add_parser("remote", help="查看或绑定 GitHub/GitLab 私有云端仓库（可选）")
    p_remote.add_argument("url", nargs="?", default="", help="远端 Git 仓库 URL（建议使用 Private 仓库）")
    p_remote.add_argument("--name", default="origin", help="远端名称（默认 origin）")
    p_remote.add_argument("--remove", action="store_true", help="移除指定远端仓库")

    p_sync = sub.add_parser("sync", help="与云端 Git 仓库双向同步（拉取 rebase + 推送）")
    p_sync.add_argument("--remote", default="origin", help="远端名称（默认 origin）")
    p_sync.add_argument("--branch", default="", help="同步分支（默认当前分支）")
    p_sync.add_argument("--dry-run", action="store_true", help="仅预览同步动作，不实际推送")
    sync_sub = p_sync.add_subparsers(dest="sync_cmd")
    p_sync_sched = sync_sub.add_parser("schedule", help="管理每日定时自动远程同步（macOS launchd / Linux crontab）")
    p_sync_sched.add_argument("--enable", action="store_true", help="开启每日定时自动同步")
    p_sync_sched.add_argument("--disable", action="store_true", help="关闭每日定时自动同步")
    p_sync_sched.add_argument("--status", action="store_true", help="查看当前定时同步状态")
    p_sync_sched.add_argument("--time", default="23:00", help="每日同步时间 HH:MM（默认 23:00）")

    args = parser.parse_args()
    root = get_tree_root()

    if args.cmd == "init":
        cmd_init(root, args)
    elif args.cmd == "install-skill":
        cmd_install_skill(root, args)
    elif args.cmd == "sync-global":
        cmd_sync_global(root, args)
    elif args.cmd == "context":
        cmd_context(root, args)
    elif args.cmd == "seed":
        if args.seed_cmd == "scan":
            tree_seed.cmd_seed_scan(root, args, log_audit)
        elif args.seed_cmd == "extract":
            tree_seed.cmd_seed_extract(root, args, log_audit)
        elif args.seed_cmd == "read":
            tree_seed.cmd_seed_read(root, args, log_audit)
        elif args.seed_cmd == "import":
            tree_seed.cmd_seed_import(root, args, log_audit)
        elif args.seed_cmd == "status":
            tree_seed.cmd_seed_status(root, args, log_audit)
        elif args.seed_cmd == "clear":
            tree_seed.cmd_seed_clear(root, args, log_audit)
        else:
            p_seed.print_help()
    elif args.cmd == "chat":
        if args.chat_cmd == "list":
            tree_seed.cmd_chat_list(root, args, log_audit)
        elif args.chat_cmd == "read":
            tree_seed.cmd_chat_read(root, args, log_audit)
        else:
            p_chat.print_help()
    elif args.cmd == "list":
        cmd_list(root, args)
    elif args.cmd == "read":
        cmd_read(root, args)
    elif args.cmd == "rules":
        cmd_rules(root, args)
    elif args.cmd == "write":
        cmd_write(root, args)
    elif args.cmd == "delete":
        cmd_delete(root, args)
    elif args.cmd == "move":
        cmd_move(root, args)
    elif args.cmd == "branch":
        cmd_branch(root, args)
    elif args.cmd == "recent":
        cmd_recent(root, args)
    elif args.cmd == "search":
        cmd_search(root, args)
    elif args.cmd == "lint":
        cmd_lint(root, args)
    elif args.cmd == "diff":
        cmd_diff(root, args)
    elif args.cmd == "revert":
        cmd_revert(root, args)
    elif args.cmd == "log":
        cmd_log(root, args)
    elif args.cmd == "remote":
        cmd_remote(root, args)
    elif args.cmd == "sync":
        if args.sync_cmd == "schedule":
            cmd_sync_schedule(root, args)
        else:
            cmd_sync(root, args)
    else:
        parser.print_help()


if __name__ == "__main__":
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        main()
    except ValueError as exc:
        print(f"❌ {exc}", file=sys.stderr)
        sys.exit(1)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
